<UserControl x:Class="WitchDrawer.App.Controls.TodoTitleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WitchDrawer.App.Localization"
             xmlns:infrastructure="clr-namespace:WitchDrawer.App.Infrastructure"
             x:Name="Root"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <infrastructure:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="TodoContent" Margin="0,0,4,0">
            <Border Background="Transparent" MinHeight="30" VerticalAlignment="Center"
                    ToolTip="{Binding TimeLabel}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown"
                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Grid Margin="0,0,12,0"
                  Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Editor" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="200" MinHeight="32" Padding="5,2" FontSize="13"
                         VerticalContentAlignment="Center" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource PanelBrush}"
                         BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,2"
                         ToolTip="{loc:Text EnterToSaveEscToCancel}" AutomationProperties.Name="{loc:Text TaskText}" />
                <Button Grid.Column="1" Click="OnSave" Content="&#xE73E;" FontFamily="Segoe Fluent Icons"
                        Width="28" Height="30" Padding="0" Margin="2,0,0,0" Style="{DynamicResource GhostButtonStyle}"
                        Foreground="{DynamicResource AccentBrush}" ToolTip="{loc:Text SaveEnter}"
                        AutomationProperties.Name="{loc:Text SaveTask}" />
                <Button Grid.Column="2" Click="OnCancel" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11"
                        Width="28" Height="30" Padding="0" Style="{DynamicResource GhostButtonStyle}"
                        Foreground="{DynamicResource TextMutedBrush}" ToolTip="{loc:Text CancelEsc}"
                        AutomationProperties.Name="{loc:Text CancelEditing}" />
            </Grid>
        </Grid>

        <!-- Keep the desktop overlay scrollbar and resize edge clear of row actions. -->
        <Border x:Name="TodoActionRail"
                Grid.Column="1"
                Width="56"
                Margin="5,0,16,0"
                MinHeight="28"
                Background="Transparent"
                BorderThickness="0"
                VerticalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Button Click="OnBeginEdit"
                        Content="&#xE70F;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="11"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Style="{DynamicResource GhostButtonStyle}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        ToolTip="{loc:Text EditTaskF2}"
                        AutomationProperties.Name="{loc:Text EditTask}" />
                <Button Command="{Binding DeleteCommand, ElementName=Root}"
                        CommandParameter="{Binding}"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Style="{DynamicResource GhostButtonStyle}"
                        Foreground="{DynamicResource TextMutedBrush}"
                        ToolTip="{loc:Text DeleteTask}"
                        AutomationProperties.Name="{loc:Text DeleteTask}">
                    <TextBlock Text="&#xE74D;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="11.5"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
