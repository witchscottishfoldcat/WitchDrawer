<Thumb x:Class="WitchDrawer.App.Controls.TodoReorderHandle"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:loc="clr-namespace:WitchDrawer.App.Localization"
       Width="20" MinHeight="28" Cursor="SizeNS" Focusable="True"
       ToolTip="{loc:Text MoveTodoHint}" AutomationProperties.Name="{loc:Text MoveTodoHint}"
       DragStarted="OnStart" DragDelta="OnMove" DragCompleted="OnFinish">
    <Thumb.Template>
        <ControlTemplate TargetType="Thumb">
            <Border Background="Transparent">
                <Path x:Name="Grip" Width="6" Height="12" VerticalAlignment="Center"
                      Data="M1,1 h0.1 M5,1 h0.1 M1,6 h0.1 M5,6 h0.1 M1,11 h0.1 M5,11 h0.1"
                      Stroke="{DynamicResource TextMutedBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeThickness="2" Opacity="0.65" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Grip" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Grip" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Grip" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Thumb.Template>
</Thumb>
