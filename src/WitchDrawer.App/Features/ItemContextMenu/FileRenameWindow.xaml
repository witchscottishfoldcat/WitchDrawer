<Window x:Class="WitchDrawer.App.Features.ItemContextMenu.FileRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WitchDrawer.App.Localization"
        Title="{loc:Text Rename}" Width="390" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <StackPanel Margin="18">
        <TextBlock x:Name="Description" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBox x:Name="NameInput" MinWidth="300" Padding="6" AutomationProperties.Name="{loc:Text NewName}" />
        <TextBlock x:Name="ErrorText" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Text Cancel}" MinWidth="72" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="{loc:Text OK}" MinWidth="72" IsDefault="True" Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
