<Window x:Class="WitchDrawer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WitchDrawer.App.Views"
        xmlns:viewModels="clr-namespace:WitchDrawer.App.ViewModels"
        xmlns:infrastructure="clr-namespace:WitchDrawer.App.Infrastructure"
        Title="WitchDrawer"
        Icon="/Assets/app.png"
        Width="1000"
        Height="620"
        MinWidth="920"
        MinHeight="560"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Drop="OnFilesDropped"
        PreviewMouseDown="OnMainWindowPreviewMouseDown"
        Deactivated="OnMainWindowDeactivated"
        PreviewDragOver="OnPreviewDragOver">
    <Border Margin="14"
            Background="{DynamicResource ControlCenterSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Color="#000000" Opacity="0.12" ShadowDepth="3" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ControlCenterSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="24,24,0,0"
                    IsHitTestVisible="False" />

            <!-- Top Header & Custom Window Chrome -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnShellHeaderMouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="32" Height="32" CornerRadius="9" ClipToBounds="True" Background="Transparent">
                        <Image Source="/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" Width="32" Height="32" />
                    </Border>
                    <TextBlock Text="WitchDrawer"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               />
                </StackPanel>

                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,4"
                        IsHitTestVisible="False">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10.5"
                               FontWeight="Medium" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="{DynamicResource PanelAltBrush}"
                            BorderThickness="0"
                            CornerRadius="9"
                            Padding="10,5"
                            Margin="0,0,10,0">
                        <TextBlock Text="Ctrl+Alt+W"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   FontWeight="Medium" />
                    </Border>

                    <Button Width="34"
                            Height="34"
                            Padding="0"
                            Focusable="False"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="OnMinimizeClicked"
                            ToolTip="最小化">
                        <Path Data="M 1,5 L 11,5"
                              Stroke="{DynamicResource TextMutedBrush}"
                              StrokeThickness="1.4"
                              Width="12"
                              Height="10"
                              Stretch="Uniform" />
                    </Button>
                    <Button Width="34"
                            Height="34"
                            Padding="0"
                            Focusable="False"
                            Click="OnCloseClicked"
                            ToolTip="关闭">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButtonStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Panel -->
            <Grid Grid.Row="1" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="222" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1"
                        Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="0,0,24,0"
                        IsHitTestVisible="False" />

                <!-- Left Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,24"
                        Padding="14,18,14,16">
                    <Grid>
                        <!-- Navigation Tabs Local Resources -->
                        <Grid.Resources>
                            <Style x:Key="NavButtonBaseStyle" TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="MinHeight" Value="38" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="Root"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="FooterNavButtonStyle"
                                   TargetType="{x:Type Button}"
                                   BasedOn="{StaticResource NavButtonBaseStyle}">
                                <Setter Property="Height" Value="38" />
                                <Setter Property="MinHeight" Value="38" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="Margin" Value="1,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="NavArchiveButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource FooterNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArchivePage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="NavSettingsButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource FooterNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="NavAboutButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource FooterNavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Height="32"
                              Margin="10,0,10,7"
                              AutomationProperties.Name="收纳盒列表">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="收纳盒"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Boxes.Count}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                            <ListBox x:Name="BoxesList"
                                     Grid.Row="1"
                                     ItemsSource="{Binding Boxes}"
                                     SelectedItem="{Binding SelectedBox, Mode=TwoWay}"
                                     AllowDrop="True"
                                     SelectionChanged="OnBoxesSelectionChanged"
                                     MouseDoubleClick="OnBoxesMouseDoubleClick"
                                     PreviewMouseLeftButtonDown="OnBoxesPreviewMouseLeftButtonDown"
                                     PreviewMouseLeftButtonUp="OnBoxesPreviewMouseLeftButtonUp"
                                     PreviewMouseMove="OnBoxesPreviewMouseMove"
                                     DragOver="OnBoxesDragOver"
                                     Drop="OnBoxesDrop"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     Margin="0,0,0,6">
                                <ListBox.Resources>
                                    <Style TargetType="{x:Type ScrollBar}"
                                           BasedOn="{StaticResource DrawerScrollBarStyle}" />
                                    <Style x:Key="SidebarBoxIconPathStyle"
                                           TargetType="{x:Type Path}">
                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="StrokeThickness" Value="1.6" />
                                        <Setter Property="StrokeStartLineCap" Value="Round" />
                                        <Setter Property="StrokeEndLineCap" Value="Round" />
                                        <Setter Property="StrokeLineJoin" Value="Round" />
                                        <Setter Property="Fill" Value="Transparent" />
                                    </Style>
                                    <Style x:Key="SidebarBoxIconCellStyle"
                                           TargetType="{x:Type Rectangle}">
                                        <Setter Property="Width" Value="4.25" />
                                        <Setter Property="Height" Value="4.25" />
                                        <Setter Property="RadiusX" Value="1.2" />
                                        <Setter Property="RadiusY" Value="1.2" />
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    </Style>
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="MinHeight" Value="52" />
                                        <Setter Property="Padding" Value="10,8" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <Border x:Name="Root"
                                                            Margin="0,2"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="Transparent"
                                                            BorderThickness="1"
                                                            BorderBrush="Transparent"
                                                            CornerRadius="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border x:Name="Indicator"
                                                                    Width="3"
                                                                    Height="18"
                                                                    Background="{DynamicResource AccentBrush}"
                                                                    CornerRadius="2"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="Collapsed"
                                                                    Margin="-3,0,8,0" />
                                                            <ContentPresenter Grid.Column="1" />
                                                            <Border x:Name="DropBefore"
                                                                    Grid.ColumnSpan="2"
                                                                    Height="2"
                                                                    Margin="0,-7,0,0"
                                                                    Background="{DynamicResource AccentBrush}"
                                                                    CornerRadius="1"
                                                                    VerticalAlignment="Top"
                                                                    Panel.ZIndex="2"
                                                                    Visibility="Collapsed" />
                                                            <Border x:Name="DropAfter"
                                                                    Grid.ColumnSpan="2"
                                                                    Height="2"
                                                                    Margin="0,0,0,-7"
                                                                    Background="{DynamicResource AccentBrush}"
                                                                    CornerRadius="1"
                                                                    VerticalAlignment="Bottom"
                                                                    Panel.ZIndex="2"
                                                                    Visibility="Collapsed" />
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                            <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                                                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                        <Trigger Property="Tag" Value="DropBefore">
                                                            <Setter TargetName="DropBefore" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                        <Trigger Property="Tag" Value="DropAfter">
                                                            <Setter TargetName="DropAfter" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding StorageLabel}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="BadgeBorder"
                                                    Width="32"
                                                    Height="32"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    BorderThickness="0">
                                                <Grid Width="18" Height="18">
                                                    <Viewbox x:Name="NormalBoxIcon"
                                                             Width="18"
                                                             Height="18"
                                                             Stretch="Uniform">
                                                        <Canvas Width="18" Height="18">
                                                            <Path Style="{StaticResource SidebarBoxIconPathStyle}"
                                                                  Data="M 3.75,7.15 L 14.25,7.15 L 13.9,13.95 C 13.85,14.85 13.1,15.55 12.2,15.55 L 5.8,15.55 C 4.9,15.55 4.15,14.85 4.1,13.95 Z M 3.3,3.15 L 14.7,3.15 C 15.3,3.15 15.8,3.65 15.8,4.25 L 15.8,5.75 C 15.8,6.35 15.3,6.85 14.7,6.85 L 3.3,6.85 C 2.7,6.85 2.2,6.35 2.2,5.75 L 2.2,4.25 C 2.2,3.65 2.7,3.15 3.3,3.15 Z M 7,10.35 L 11,10.35" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <Viewbox x:Name="MappingBoxIcon"
                                                             Width="18"
                                                             Height="18"
                                                             Stretch="Uniform"
                                                             Visibility="Collapsed">
                                                        <Canvas Width="18" Height="18">
                                                            <Path Style="{StaticResource SidebarBoxIconPathStyle}"
                                                                  Data="M 7.4,11.5 L 5.8,13.1 C 4.7,14.2 3,14.2 1.9,13.1 C 0.8,12 0.8,10.3 1.9,9.2 L 4.4,6.7 C 5.5,5.6 7.2,5.6 8.3,6.7 M 10.6,6.5 L 12.2,4.9 C 13.3,3.8 15,3.8 16.1,4.9 C 17.2,6 17.2,7.7 16.1,8.8 L 13.6,11.3 C 12.5,12.4 10.8,12.4 9.7,11.3 M 6.6,11.4 L 11.4,6.6" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <Viewbox x:Name="TodoBoxIcon"
                                                             Width="18"
                                                             Height="18"
                                                             Stretch="Uniform"
                                                             Visibility="Collapsed">
                                                        <Canvas Width="18" Height="18">
                                                            <Path Style="{StaticResource SidebarBoxIconPathStyle}"
                                                                  Data="M 5.15,2.35 L 12.85,2.35 C 14.4,2.35 15.65,3.6 15.65,5.15 L 15.65,12.85 C 15.65,14.4 14.4,15.65 12.85,15.65 L 5.15,15.65 C 3.6,15.65 2.35,14.4 2.35,12.85 L 2.35,5.15 C 2.35,3.6 3.6,2.35 5.15,2.35 Z M 5.45,9.15 L 8.05,11.75 L 12.85,6.55" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <Viewbox x:Name="DrawerBoxIcon"
                                                             Width="18"
                                                             Height="18"
                                                             Stretch="Uniform"
                                                             Visibility="Collapsed">
                                                        <Canvas Width="18" Height="18">
                                                            <Rectangle Canvas.Left="3.25"
                                                                       Canvas.Top="3.25"
                                                                       Style="{StaticResource SidebarBoxIconCellStyle}" />
                                                            <Rectangle Canvas.Left="10.5"
                                                                       Canvas.Top="3.25"
                                                                       Style="{StaticResource SidebarBoxIconCellStyle}" />
                                                            <Rectangle Canvas.Left="3.25"
                                                                       Canvas.Top="10.5"
                                                                       Style="{StaticResource SidebarBoxIconCellStyle}" />
                                                            <Rectangle Canvas.Left="10.5"
                                                                       Canvas.Top="10.5"
                                                                       Style="{StaticResource SidebarBoxIconCellStyle}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                            FontSize="13.5"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                            FontSize="11"
                                                           Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Mapping">
                                                <Setter TargetName="NormalBoxIcon" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="MappingBoxIcon" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Todo">
                                                <Setter TargetName="NormalBoxIcon" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="TodoBoxIcon" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Drawer">
                                                <Setter TargetName="NormalBoxIcon" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="DrawerBoxIcon" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                            <Button x:Name="BtnCreateBox"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnCreateBoxClicked"
                                    AutomationProperties.Name="新建"
                                    MinHeight="40">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 0,4 L 8,4 M 4,0 L 4,8" Stroke="White" StrokeThickness="1.5" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" SnapsToDevicePixels="True" />
                                    <TextBlock Text="新建" VerticalAlignment="Center" FontSize="12.5" />
                                </StackPanel>
                            </Button>

                            <!-- 定制级极简纯净菜单悬浮窗 -->
                            <Popup x:Name="CreateBoxPopup"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   PlacementTarget="{Binding ElementName=BtnCreateBox}"
                                   Placement="Top"
                                   VerticalOffset="-6"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="6"
                                        Margin="16">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.12" Direction="270" />
                                    </Border.Effect>
                                    <StackPanel MinWidth="224">
                                        <Button Content="普通收纳盒"
                                                Click="OnCreateNormalBoxClicked"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Margin="0,0,0,4"
                                                Padding="12,10" />
                                        <Button Content="映射收纳盒" Click="OnCreateMappingBoxClicked" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,4" Padding="12,10" />
                                        <Button Content="抽屉收纳盒" Click="OnCreateDrawerBoxClicked" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,4" Padding="12,10" />
                                        <Button Content="待办收纳盒" Click="OnCreateTodoBoxClicked" Style="{StaticResource GhostButtonStyle}" Padding="12,10" />
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Border Height="1"
                                    Margin="8,9,8,5"
                                     Background="{DynamicResource BorderBrushSoft}"
                                     Opacity="0.72" />

                            <UniformGrid Columns="3">
                                <Button Command="{Binding ShowArchiveCommand}"
                                        Style="{StaticResource NavArchiveButtonStyle}"
                                        AutomationProperties.Name="归档">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2,5 L 17,5 L 17,17 L 2,17 Z M 1,2 L 18,2 L 18,6 L 1,6 Z M 7,9 L 12,9"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4"
                                              Width="14"
                                              Height="14"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,5,0" />
                                        <TextBlock Text="归档"
                                                   FontSize="11.5"
                                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ShowSettingsCommand}"
                                        Style="{StaticResource NavSettingsButtonStyle}"
                                        AutomationProperties.Name="设置">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 9.5,2 L 11,2.5 L 11.8,5 L 14.2,5.8 L 16.5,4.7 L 17.5,6 L 16,8.2 L 16,10.8 L 17.5,13 L 16.5,14.3 L 14.2,13.2 L 11.8,14 L 11,16.5 L 9.5,17 L 8,16.5 L 7.2,14 L 4.8,13.2 L 2.5,14.3 L 1.5,13 L 3,10.8 L 3,8.2 L 1.5,6 L 2.5,4.7 L 4.8,5.8 L 7.2,5 L 8,2.5 Z M 7,9.5 A 2.5,2.5 0 1 0 12,9.5 A 2.5,2.5 0 1 0 7,9.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.25"
                                              Width="14"
                                              Height="14"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,5,0" />
                                        <TextBlock Text="设置"
                                                   FontSize="11.5"
                                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ShowAboutCommand}"
                                        Style="{StaticResource NavAboutButtonStyle}"
                                        AutomationProperties.Name="关于">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;"
                                                   Width="15"
                                                   Margin="0,0,5,0"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="14"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="关于"
                                                   FontSize="11.5"
                                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Content Area -->
                <Grid Grid.Column="1" Margin="24,18,24,22" VerticalAlignment="Stretch">
                    <!-- Dashboard Page -->
                    <Grid VerticalAlignment="Stretch">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAboutPage}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsArchivePage}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Dashboard Info Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="5"
                                            Height="5"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="3"
                                            Margin="1,0,8,0"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedBox.Description, TargetNullValue=选择左侧的收纳盒开始整理}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11.5"
                                               FontWeight="Medium"
                                               />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding SelectedBox.Name, TargetNullValue=选择一个收纳盒}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="28"
                                               FontWeight="SemiBold" />
                                    
                                    <!-- 重命名收纳盒悬浮按钮与浮窗 -->
                                    <Grid Margin="10,1,0,0">
                                         <Button x:Name="BtnRenameBox"
                                                 Click="OnRenameBoxClicked"
                                                 Focusable="False"
                                                 Style="{StaticResource GhostButtonStyle}"
                                                 AutomationProperties.Name="重命名当前收纳盒"
                                                 Width="32" Height="32"
                                                 Padding="0"
                                                 ToolTip="重命名收纳盒"
                                                 BorderThickness="0">
                                            <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                  Fill="{DynamicResource TextMutedBrush}"
                                                  Stretch="Uniform" Width="14" Height="14" />
                                        </Button>

                                        <Popup x:Name="RenameBoxPopup"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PlacementTarget="{Binding ElementName=BtnRenameBox}"
                                               Placement="Right"
                                               HorizontalOffset="10"
                                               VerticalOffset="-12"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,12"
                                                    Margin="16">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.15" Direction="270" />
                                                </Border.Effect>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="TxtRenameBox"
                                                             Width="180" Height="32"
                                                             VerticalContentAlignment="Center"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             Background="{DynamicResource PanelBrush}"
                                                             BorderBrush="{DynamicResource BorderBrushSoft}"
                                                             BorderThickness="1"
                                                             Padding="8,0"
                                                             KeyDown="OnRenameBoxKeyDown"
                                                             PreviewKeyDown="OnRenameBoxPreviewKeyDown" />
                                                    <Button Content="确认" 
                                                            Click="OnConfirmRenameBoxClicked"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Margin="8,0,0,0"
                                                            Padding="16,0" Height="32"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <Grid Width="0" Margin="0">
                                        <Popup x:Name="DeleteConfirmPopup"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PlacementTarget="{Binding ElementName=BtnMoreBoxActions}"
                                               Placement="Bottom"
                                               VerticalOffset="6"
                                               HorizontalOffset="-92"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="16,14"
                                                    Margin="16">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="18"
                                                                      ShadowDepth="5"
                                                                      Opacity="0.16"
                                                                      Direction="270" />
                                                </Border.Effect>
                                                <StackPanel MinWidth="210">
                                                    <TextBlock Text="删除这个收纳盒？"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Margin="0,0,0,6" />
                                                    <TextBlock Text="{Binding SelectedBox.DeleteWarning}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,0,0,14"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <Button Content="取消"
                                                                Click="OnCancelDeleteBoxClicked"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Margin="0,0,6,0"
                                                                Padding="12,5" />
                                                        <Button Content="删除"
                                                                Click="OnConfirmDeleteBoxClicked"
                                                                Style="{StaticResource DangerButtonStyle}"
                                                                Padding="14,5" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <Grid Margin="6,1,0,0">
                                        <Button x:Name="BtnMoreBoxActions"
                                                Width="32"
                                                Height="32"
                                                MinWidth="32"
                                                MinHeight="32"
                                                Padding="0"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Click="OnOpenBoxActionsMenu"
                                                ToolTip="更多收纳盒操作"
                                                AutomationProperties.Name="更多收纳盒操作">
                                            <TextBlock Text="&#xE712;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="15"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>

                                        <Popup x:Name="BoxActionsPopup"
                                               PlacementTarget="{Binding ElementName=BtnMoreBoxActions}"
                                               Placement="Bottom"
                                               VerticalOffset="6"
                                               HorizontalOffset="-116"
                                               AllowsTransparency="True"
                                               StaysOpen="True"
                                               PopupAnimation="Fade">
                                            <Border Margin="14"
                                                    Padding="6"
                                                    MinWidth="174"
                                                    Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16"
                                                                      ShadowDepth="4"
                                                                      Opacity="0.14"
                                                                      Direction="270" />
                                                </Border.Effect>
                                                <StackPanel>
                                                    <Button Command="{Binding ToggleSelectedBoxPositionLockCommand}"
                                                            Click="OnBoxActionMenuItemClicked"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            AutomationProperties.Name="{Binding SelectedBox.PositionLockButtonToolTip}"
                                                            Padding="10,8"
                                                            HorizontalContentAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE72E;"
                                                                       Width="20"
                                                                       FontFamily="Segoe Fluent Icons"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding SelectedBox.PositionLockButtonToolTip}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{Binding SelectedBox.ToggleTitleVisibilityCommand}"
                                                            Click="OnBoxActionMenuItemClicked"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            AutomationProperties.Name="{Binding SelectedBox.TitleVisibilityAutomationName}"
                                                            Padding="10,8"
                                                            HorizontalContentAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE890;"
                                                                       Width="20"
                                                                       FontFamily="Segoe Fluent Icons"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding SelectedBox.TitleVisibilityAutomationName}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Border Height="1"
                                                            Margin="8,4"
                                                            Background="{DynamicResource BorderBrushSoft}" />
                                                    <Button Click="OnDeleteBoxClicked"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            Foreground="{DynamicResource DangerBrush}"
                                                            AutomationProperties.Name="删除收纳盒"
                                                            Padding="10,8"
                                                            HorizontalContentAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE74D;"
                                                                       Width="20"
                                                                       FontFamily="Segoe Fluent Icons"
                                                                       FontSize="13" />
                                                            <TextBlock Text="删除收纳盒"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Margin="0,0,8,0"
                                      Visibility="{Binding SelectedBox.IsDrawerBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button x:Name="DrawerSortMenuButton"
                                            Click="OnOpenDrawerSortMenu"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="9,5"
                                            ToolTip="选择抽屉图标排序方式">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8CB;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="排序"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SelectedBox.DrawerSortModeLabel, StringFormat= · {0}}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="&#xE70D;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="8"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Popup x:Name="DrawerSortPopup"
                                           PlacementTarget="{Binding ElementName=DrawerSortMenuButton}"
                                           Placement="Bottom"
                                           VerticalOffset="5"
                                           AllowsTransparency="True"
                                           StaysOpen="False"
                                           PopupAnimation="Fade">
                                        <Border Margin="12"
                                                Padding="5"
                                                MinWidth="156"
                                                Background="{DynamicResource PanelBrush}"
                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="14"
                                                                  ShadowDepth="3"
                                                                  Opacity="0.12"
                                                                  Direction="270" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <Button Command="{Binding SelectedBox.ApplyDrawerSortModeCommand}"
                                                        CommandParameter="{x:Static viewModels:DrawerItemSortMode.Name}"
                                                        Click="OnDrawerSortOptionClicked"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="10,8">
                                                    <Grid Width="128">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE73E;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding SelectedBox.IsDrawerSortByName, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock Grid.Column="1" Text="名称" />
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding SelectedBox.ApplyDrawerSortModeCommand}"
                                                        CommandParameter="{x:Static viewModels:DrawerItemSortMode.Size}"
                                                        Click="OnDrawerSortOptionClicked"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="10,8">
                                                    <Grid Width="128">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE73E;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding SelectedBox.IsDrawerSortBySize, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock Grid.Column="1" Text="大小" />
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding SelectedBox.ApplyDrawerSortModeCommand}"
                                                        CommandParameter="{x:Static viewModels:DrawerItemSortMode.ItemType}"
                                                        Click="OnDrawerSortOptionClicked"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="10,8">
                                                    <Grid Width="128">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE73E;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding SelectedBox.IsDrawerSortByItemType, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock Grid.Column="1" Text="项目类型" />
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding SelectedBox.ApplyDrawerSortModeCommand}"
                                                        CommandParameter="{x:Static viewModels:DrawerItemSortMode.ModifiedDate}"
                                                        Click="OnDrawerSortOptionClicked"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Padding="10,8">
                                                    <Grid Width="128">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE73E;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding SelectedBox.IsDrawerSortByModifiedDate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock Grid.Column="1" Text="修改日期" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Border Background="{DynamicResource PanelAltBrush}"
                                        BorderThickness="0"
                                        CornerRadius="9"
                                        Padding="10,6"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 1,4 L 10,1 L 19,4 L 19,15 L 10,18 L 1,15 Z M 1,4 L 10,7 L 19,4 M 10,7 L 10,18" 
                                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Boxes.Count, StringFormat={}{0} 个收纳盒}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="10,6"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2,1 L 9,1 L 13,5 L 13,14 L 2,14 Z M 9,1 L 9,5 L 13,5" 
                                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2" Width="11" Height="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Items.Count, StringFormat={}{0} 个文件}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="10,6"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8FD;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding TodoBoxDetail.RemainingCount, StringFormat=剩余 {0} 项}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" VerticalAlignment="Stretch">
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelectedTodoBox}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Selected box controls -->
                            <Grid Grid.Row="0" Margin="0,0,0,12" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- 顶部状态卡片 -->
                                    <RowDefinition Height="Auto" /> <!-- 收纳盒属性配置卡片 -->
                                    <RowDefinition Height="*" />    <!-- 投放区：使用 * 星号自适应撑满左侧的全部剩余纵向空间 -->
                                </Grid.RowDefinitions>

                                <!-- 顶部精美渐变桌面状态卡片 -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Margin="0,0,0,10"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Border CornerRadius="16" IsHitTestVisible="False" Opacity="0.45">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#66FFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="0.7" />
                                                    <GradientStop Color="#140EA5E9" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Margin="14,12">
                                            <TextBlock Text="桌面收纳栏"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       />
                                            <TextBlock Text="{Binding Boxes.Count}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       Margin="0,1,0,0" />
                                            <TextBlock Text="所有收纳盒已同步到桌面"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="10.5"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 扁平合并型“收纳盒配置”超级卡片 (高度极度紧凑自适应) -->
                                <Border Grid.Row="1"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14,5"
                                        Margin="0">
                                    <!-- MinHeight 固定为两行展开后的高度（38 + 6 + 32）：盒子尺寸行按盒型显隐时
                                         卡片高度保持恒定，PrimaryPanel 垂直居中，避免下方内容区瞬间移位（页面抖动）。 -->
                                    <Grid x:Name="BoxControlsPageHost"
                                          MinHeight="76"
                                          ClipToBounds="True">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="BoxControlsPageStates">
                                                <VisualStateGroup.Transitions>
                                                    <VisualTransition GeneratedDuration="0:0:0.2">
                                                        <VisualTransition.GeneratedEasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </VisualTransition.GeneratedEasingFunction>
                                                    </VisualTransition>
                                                </VisualStateGroup.Transitions>
                                                <VisualState x:Name="PrimaryControlsState">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="BoxControlsPrimaryPanel"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1" />
                                                        <DoubleAnimation Storyboard.TargetName="BoxControlsPrimaryTransform"
                                                                         Storyboard.TargetProperty="X"
                                                                         To="0" />
                                                        <DoubleAnimation Storyboard.TargetName="BoxVisualStyleSecondaryPanel"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0" />
                                                        <DoubleAnimation Storyboard.TargetName="BoxVisualStyleSecondaryTransform"
                                                                         Storyboard.TargetProperty="X"
                                                                         To="28" />
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="VisualStyleSelectionState">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="BoxControlsPrimaryPanel"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0" />
                                                        <DoubleAnimation Storyboard.TargetName="BoxControlsPrimaryTransform"
                                                                         Storyboard.TargetProperty="X"
                                                                         To="-28" />
                                                        <DoubleAnimation Storyboard.TargetName="BoxVisualStyleSecondaryPanel"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1" />
                                                        <DoubleAnimation Storyboard.TargetName="BoxVisualStyleSecondaryTransform"
                                                                         Storyboard.TargetProperty="X"
                                                                         To="0" />
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>

                                        <Grid x:Name="BoxControlsPrimaryPanel"
                                              VerticalAlignment="Center">
                                            <Grid.RenderTransform>
                                                <TranslateTransform x:Name="BoxControlsPrimaryTransform" />
                                            </Grid.RenderTransform>
                                            <Grid.Resources>
                                                <Style x:Key="BoxControlLabelStyle"
                                                       TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter Property="FontSize" Value="11.5" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                                <Style x:Key="VisualStylePickerButtonStyle"
                                                       TargetType="{x:Type Button}"
                                                       BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Height" Value="30" />
                                                    <Setter Property="MinHeight" Value="30" />
                                                    <Setter Property="MinWidth" Value="78" />
                                                    <Setter Property="Padding" Value="10,0" />
                                                    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter Property="FontSize" Value="10.5" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Resources>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="38" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="132" />
                                                <ColumnDefinition Width="178" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0"
                                                  Height="38"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                                <TextBlock Text="收纳方式"
                                                           Style="{StaticResource BoxControlLabelStyle}" />
                                                <Border Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        CornerRadius="6">
                                                    <TextBlock Text="{Binding SelectedBox.TypeLabel}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>

                                            <Grid Grid.Column="1"
                                                  Height="38"
                                                  Margin="8,0,12,0"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding SelectedBox.CanSelectVisualStyle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="图标风格"
                                                           Style="{StaticResource BoxControlLabelStyle}" />
                                                <Button x:Name="BoxVisualStyleDrawerToggle"
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Content="{Binding SelectedBox.VisualStyleLabel}"
                                                        Style="{StaticResource VisualStylePickerButtonStyle}"
                                                        ToolTip="选择图标风格"
                                                        Click="OnOpenBoxVisualStylePage" />
                                            </Grid>

                                            <Grid Grid.Column="1"
                                                  Height="38"
                                                  Margin="8,0,12,0"
                                                  VerticalAlignment="Center"
                                                  Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="抽屉名称"
                                                           Style="{StaticResource BoxControlLabelStyle}" />
                                                <Button Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Content="{Binding SelectedBox.TitleVisibilityAutomationName}"
                                                        Command="{Binding SelectedBox.ToggleTitleVisibilityCommand}"
                                                        Style="{StaticResource VisualStylePickerButtonStyle}"
                                                        ToolTip="显示或隐藏桌面抽屉名称" />
                                            </Grid>

                                            <Grid
                                                  Height="34"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center">
                                                <Grid.Style>
                                                    <Style TargetType="{x:Type Grid}">
                                                        <Setter Property="Grid.Column" Value="2" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedBox.IsDrawerBox}" Value="True">
                                                                <Setter Property="Grid.Column" Value="1" />
                                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="图标大小"
                                                           Margin="0,0,10,0"
                                                           Style="{StaticResource BoxControlLabelStyle}" />

                                                <Border Grid.Column="1"
                                                    Height="36"
                                                    Background="{DynamicResource PanelAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="2">
                                            <UniformGrid Columns="4" Rows="1" VerticalAlignment="Center">
                                                <UniformGrid.Resources>
                                                    <Style x:Key="IconSizeChoiceButtonStyle"
                                                           TargetType="{x:Type Button}"
                                                           BasedOn="{StaticResource GhostButtonStyle}">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        <Setter Property="MinHeight" Value="28" />
                                                        <Setter Property="Padding" Value="10,4" />
                                                        <Setter Property="FontSize" Value="10.5" />
                                                        <Setter Property="FontWeight" Value="Medium" />
                                                    </Style>
                                                    <Style x:Key="ExtraLargeIconSizeButtonStyle"
                                                           TargetType="{x:Type Button}"
                                                           BasedOn="{StaticResource IconSizeChoiceButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedBox.LayoutSettings.IsExtraLargePreset}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style x:Key="LargeIconSizeButtonStyle"
                                                           TargetType="{x:Type Button}"
                                                           BasedOn="{StaticResource IconSizeChoiceButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedBox.LayoutSettings.IsLargePreset}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style x:Key="MediumIconSizeButtonStyle"
                                                           TargetType="{x:Type Button}"
                                                           BasedOn="{StaticResource IconSizeChoiceButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedBox.LayoutSettings.IsMediumPreset}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style x:Key="SmallIconSizeButtonStyle"
                                                           TargetType="{x:Type Button}"
                                                           BasedOn="{StaticResource IconSizeChoiceButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedBox.LayoutSettings.IsSmallPreset}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </UniformGrid.Resources>
                                                <Button Content="超大"
                                                        ToolTip="超大图标"
                                                        Style="{StaticResource ExtraLargeIconSizeButtonStyle}"
                                                        Command="{Binding SelectedBox.LayoutSettings.ApplyPresetCommand}"
                                                        CommandParameter="3x3" />
                                                <Button Content="大"
                                                        ToolTip="大图标"
                                                        Style="{StaticResource LargeIconSizeButtonStyle}"
                                                        Command="{Binding SelectedBox.LayoutSettings.ApplyPresetCommand}"
                                                        CommandParameter="4x4" />
                                                <Button Content="中"
                                                        ToolTip="中等图标"
                                                        Style="{StaticResource MediumIconSizeButtonStyle}"
                                                        Command="{Binding SelectedBox.LayoutSettings.ApplyPresetCommand}"
                                                        CommandParameter="5x5" />
                                                <Button Content="小"
                                                        ToolTip="小图标"
                                                        Style="{StaticResource SmallIconSizeButtonStyle}"
                                                        Command="{Binding SelectedBox.LayoutSettings.ApplyPresetCommand}"
                                                        CommandParameter="6x6" />
                                                </UniformGrid>
                                                 </Border>
                                             </Grid>

                                            <Grid Grid.Row="1"
                                                  Grid.ColumnSpan="3"
                                                  Height="34"
                                                  Margin="0,6,0,0"
                                                  Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="排序"
                                                           Margin="0,0,10,0"
                                                           Style="{StaticResource BoxControlLabelStyle}" />
                                                <Border Grid.Column="1"
                                                        Padding="2"
                                                        Background="{DynamicResource PanelAltBrush}"
                                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <UniformGrid Columns="4" Rows="1">
                                                        <UniformGrid.Resources>
                                                            <Style x:Key="DrawerSortChoiceButtonStyle"
                                                                   TargetType="{x:Type Button}"
                                                                   BasedOn="{StaticResource GhostButtonStyle}">
                                                                <Setter Property="MinHeight" Value="28" />
                                                                <Setter Property="Padding" Value="10,4" />
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Setter Property="BorderThickness" Value="0" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                <Setter Property="FontSize" Value="10.5" />
                                                                <Setter Property="FontWeight" Value="Medium" />
                                                            </Style>
                                                            <Style x:Key="DrawerSortByNameButtonStyle"
                                                                   TargetType="{x:Type Button}"
                                                                   BasedOn="{StaticResource DrawerSortChoiceButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedBox.IsDrawerSortByName}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="Foreground" Value="White" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                            <Style x:Key="DrawerSortBySizeButtonStyle"
                                                                   TargetType="{x:Type Button}"
                                                                   BasedOn="{StaticResource DrawerSortChoiceButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedBox.IsDrawerSortBySize}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="Foreground" Value="White" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                            <Style x:Key="DrawerSortByTypeButtonStyle"
                                                                   TargetType="{x:Type Button}"
                                                                   BasedOn="{StaticResource DrawerSortChoiceButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedBox.IsDrawerSortByItemType}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="Foreground" Value="White" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                            <Style x:Key="DrawerSortByDateButtonStyle"
                                                                   TargetType="{x:Type Button}"
                                                                   BasedOn="{StaticResource DrawerSortChoiceButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedBox.IsDrawerSortByModifiedDate}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="Foreground" Value="White" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </UniformGrid.Resources>
                                                        <Button Content="名称"
                                                                Style="{StaticResource DrawerSortByNameButtonStyle}"
                                                                Command="{Binding SelectedBox.ApplyDrawerSortModeCommand}"
                                                                CommandParameter="{x:Static viewModels:DrawerItemSortMode.Name}" />
                                                        <Button Content="大小"
                                                                Style="{StaticResource DrawerSortBySizeButtonStyle}"
                                                                Command="{Binding SelectedBox.ApplyDrawerSortModeCommand}"
                                                                CommandParameter="{x:Static viewModels:DrawerItemSortMode.Size}" />
                                                        <Button Content="项目类型"
                                                                Style="{StaticResource DrawerSortByTypeButtonStyle}"
                                                                Command="{Binding SelectedBox.ApplyDrawerSortModeCommand}"
                                                                CommandParameter="{x:Static viewModels:DrawerItemSortMode.ItemType}" />
                                                        <Button Content="修改日期"
                                                                Style="{StaticResource DrawerSortByDateButtonStyle}"
                                                                Command="{Binding SelectedBox.ApplyDrawerSortModeCommand}"
                                                                CommandParameter="{x:Static viewModels:DrawerItemSortMode.ModifiedDate}" />
                                                    </UniformGrid>
                                                </Border>
                                            </Grid>

                                            <Grid Grid.Row="2"
                                                  Grid.ColumnSpan="3"
                                                  Margin="0,6,0,0">
                                                <Grid.Style>
                                                    <Style TargetType="{x:Type Grid}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedBox.SupportsFixedSize}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="盒子尺寸"
                                                           Margin="0,0,10,0"
                                                           Style="{StaticResource BoxControlLabelStyle}" />
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                    <StackPanel.Resources>
                                                        <Style x:Key="SizeModeChoiceButtonStyle"
                                                               TargetType="{x:Type Button}"
                                                               BasedOn="{StaticResource GhostButtonStyle}">
                                                            <Setter Property="MinHeight" Value="28" />
                                                            <Setter Property="Padding" Value="12,4" />
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                            <Setter Property="FontSize" Value="10.5" />
                                                            <Setter Property="FontWeight" Value="Medium" />
                                                        </Style>
                                                        <Style x:Key="AdaptiveSizeModeButtonStyle"
                                                               TargetType="{x:Type Button}"
                                                               BasedOn="{StaticResource SizeModeChoiceButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BoxSizeSettings.IsAdaptiveMode}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                        <Style x:Key="FixedSizeModeButtonStyle"
                                                               TargetType="{x:Type Button}"
                                                               BasedOn="{StaticResource SizeModeChoiceButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BoxSizeSettings.IsFixedMode}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                        <Style x:Key="SizeStepperButtonStyle"
                                                               TargetType="{x:Type Button}"
                                                               BasedOn="{StaticResource GhostButtonStyle}">
                                                            <Setter Property="Width" Value="24" />
                                                            <Setter Property="Height" Value="24" />
                                                            <Setter Property="MinWidth" Value="0" />
                                                            <Setter Property="MinHeight" Value="0" />
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </Style>
                                                    </StackPanel.Resources>
                                                    <Border Padding="2"
                                                            Background="{DynamicResource PanelAltBrush}"
                                                            BorderBrush="{DynamicResource BorderBrushSoft}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            ToolTip="{Binding BoxSizeSettings.ModeSummary}">
                                                        <UniformGrid Columns="2" Rows="1">
                                                            <Button Content="自适应"
                                                                    Style="{StaticResource AdaptiveSizeModeButtonStyle}"
                                                                    Command="{Binding BoxSizeSettings.UseAdaptiveModeCommand}" />
                                                            <Button Content="固定格数"
                                                                    Style="{StaticResource FixedSizeModeButtonStyle}"
                                                                    Command="{Binding BoxSizeSettings.UseFixedModeCommand}" />
                                                        </UniformGrid>
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="12,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <StackPanel.Style>
                                                            <Style TargetType="{x:Type StackPanel}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding BoxSizeSettings.IsFixedMode}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Button Content="−"
                                                                Style="{StaticResource SizeStepperButtonStyle}"
                                                                Command="{Binding BoxSizeSettings.DecreaseColumnsCommand}"
                                                                ToolTip="减少列数" />
                                                        <Border Background="{DynamicResource PanelAltBrush}"
                                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                                BorderThickness="1"
                                                                CornerRadius="7"
                                                                MinWidth="26"
                                                                Padding="5,1.5"
                                                                Margin="4,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BoxSizeSettings.FixedColumns}"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </Border>
                                                        <Button Content="＋"
                                                                Style="{StaticResource SizeStepperButtonStyle}"
                                                                Command="{Binding BoxSizeSettings.IncreaseColumnsCommand}"
                                                                ToolTip="增加列数" />
                                                        <TextBlock Text="×"
                                                                   Margin="9,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                        <Button Content="−"
                                                                Style="{StaticResource SizeStepperButtonStyle}"
                                                                Command="{Binding BoxSizeSettings.DecreaseRowsCommand}"
                                                                ToolTip="减少行数" />
                                                        <Border Background="{DynamicResource PanelAltBrush}"
                                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                                BorderThickness="1"
                                                                CornerRadius="7"
                                                                MinWidth="26"
                                                                Padding="5,1.5"
                                                                Margin="4,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BoxSizeSettings.FixedRows}"
                                                                       HorizontalAlignment="Center"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </Border>
                                                        <Button Content="＋"
                                                                Style="{StaticResource SizeStepperButtonStyle}"
                                                                Command="{Binding BoxSizeSettings.IncreaseRowsCommand}"
                                                                ToolTip="增加行数" />
                                                    </StackPanel>
                                                    <!-- 下限提示：解释固定模式下 − 按钮为何被禁用 -->
                                                    <TextBlock Text="{Binding BoxSizeSettings.ExtentHint}"
                                                               Margin="12,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource TextMutedBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding BoxSizeSettings.IsFixedMode}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>

                                         </Grid>

                                        <Grid x:Name="BoxVisualStyleSecondaryPanel"
                                              Opacity="0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False">
                                            <Grid.RenderTransform>
                                                <TranslateTransform x:Name="BoxVisualStyleSecondaryTransform"
                                                                    X="28" />
                                            </Grid.RenderTransform>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="0,0,8,0"
                                                    Padding="0"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Click="OnCloseBoxVisualStylePage"
                                                    ToolTip="返回">
                                                <TextBlock Text="&#xE72B;"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Button>
                                            <StackPanel Grid.Column="1"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="选择图标风格"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="点击后立即应用"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="9.5"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Padding="2"
                                                    Background="{DynamicResource PanelAltBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <ItemsControl ItemsSource="{Binding BoxVisualStyleOptions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Click="OnBoxVisualStyleSelected"
                                                                    Margin="2"
                                                                    Padding="8,7"
                                                                    HorizontalContentAlignment="Stretch">
                                                                <Button.Style>
                                                                    <Style TargetType="{x:Type Button}"
                                                                           BasedOn="{StaticResource GhostButtonStyle}">
                                                                        <Setter Property="Background" Value="Transparent" />
                                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                                        <Setter Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                            </Trigger>
                                                                            <DataTrigger Value="True">
                                                                                <DataTrigger.Binding>
                                                                                    <MultiBinding Converter="{StaticResource BoxVisualStyleEqualityConverter}">
                                                                                        <Binding Path="Style" />
                                                                                        <Binding Path="DataContext.SelectedBox.VisualStyle"
                                                                                                 RelativeSource="{RelativeSource AncestorType={x:Type ItemsControl}}" />
                                                                                    </MultiBinding>
                                                                                </DataTrigger.Binding>
                                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard>
                                                                                        <Storyboard>
                                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                                             From="0.94"
                                                                                                             To="1"
                                                                                                             Duration="0:0:0.18">
                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                    <BackEase Amplitude="0.28"
                                                                                                              EasingMode="EaseOut" />
                                                                                                </DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                                             From="0.94"
                                                                                                             To="1"
                                                                                                             Duration="0:0:0.18">
                                                                                                <DoubleAnimation.EasingFunction>
                                                                                                    <BackEase Amplitude="0.28"
                                                                                                              EasingMode="EaseOut" />
                                                                                                </DoubleAnimation.EasingFunction>
                                                                                            </DoubleAnimation>
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="28" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Width="24"
                                                                            Height="24"
                                                                            CornerRadius="7"
                                                                            Background="{DynamicResource AccentSoftBrush}">
                                                                        <TextBlock Text="{Binding Glyph}"
                                                                                   FontFamily="Segoe Fluent Icons"
                                                                                   FontSize="12"
                                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding Description}"
                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                   FontSize="9"
                                                                                   Margin="0,1,0,0"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                 </Border>

                                <!-- 投放区 (去除硬编码高度，高度由 Grid 自动伸缩拉长并保持居中，实现与右侧完美对称对齐！) -->
                                <Border Grid.Row="2"
                                        Background="{DynamicResource DropZoneBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        MinHeight="82"
                                        VerticalAlignment="Stretch"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Rectangle Stroke="{DynamicResource BorderBrushSoft}"
                                                   StrokeThickness="1"
                                                   StrokeDashArray="3 4"
                                                   RadiusX="15"
                                                   RadiusY="15"
                                                   Margin="4"
                                                   Opacity="0.8" />
                                        <StackPanel Margin="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 6,1 L 6,11 M 2,7 L 6,11 L 10,7 M 1,14 L 11,14" 
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                                  Width="12" Height="14" HorizontalAlignment="Center" Margin="0,0,0,6" SnapsToDevicePixels="True" />
                                            <TextBlock Text="投放区"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="拖入文件至此快速归纳"
                                                       Margin="0,2,0,0"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Right Files List (Glass Card panel) -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16,13"
                                    Margin="0,0,0,12">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="2,0,2,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="5"
                                                    Height="5"
                                                    CornerRadius="3"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Margin="1,0,8,0"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="文件"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="  ·  双击打开，按 Delete 移除"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right"
                                                Background="{DynamicResource PanelAltBrush}"
                                                CornerRadius="8"
                                                Padding="8,3">
                                            <TextBlock Text="{Binding Items.Count, StringFormat={}{0} 项}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Border>
                                    </Grid>

                                    <Grid>
                                        <!-- Empty State -->
                                        <Grid Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,16">
                                                <Path Data="M 5,12 L 20,4 L 35,12 L 35,28 L 20,36 L 5,28 Z M 5,12 L 20,20 L 35,12 M 20,20 L 20,36" 
                                                      Stroke="{DynamicResource BorderBrushSoft}" StrokeThickness="2" Width="48" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                                <TextBlock Text="收纳盒内无文件"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="14.5"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="把文件拖到下方投放栏即可归类到这里"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11.5"
                                                           Margin="0,5,0,0"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Files ListBox -->
                                        <ListBox x:Name="MainItemsList"
                                                 ItemsSource="{Binding Items}"
                                                 VerticalAlignment="Stretch"
                                                 ClipToBounds="True"
                                                 PreviewKeyDown="OnMainItemsPreviewKeyDown"
                                                 MouseDoubleClick="OnItemsMouseDoubleClick"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 Visibility="{Binding Items.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Setter Property="MinHeight" Value="48" />
                                                    <Setter Property="Padding" Value="8,5" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                <!-- Card border -->
                                                                <Border x:Name="Root"
                                                                        Background="Transparent"
                                                                        BorderBrush="Transparent"
                                                                        BorderThickness="1"
                                                                        CornerRadius="9"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                        <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                        <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <Border Width="32"
                                                                Height="32"
                                                                CornerRadius="9"
                                                                Background="{DynamicResource GlassInnerBrush}"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0"
                                                                HorizontalAlignment="Left">
                                                            <Grid>
                                                                <Image Source="{Binding IconImage}"
                                                                       infrastructure:DeferredIconLoad.IsEnabled="True"
                                                                       Width="20"
                                                                       Height="20"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                       UseLayoutRounding="True"
                                                                       SnapsToDevicePixels="True"
                                                                       Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <TextBlock Text="{Binding FallbackIconText}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="9"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           Visibility="{Binding HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                            </Grid>
                                                        </Border>
                                                        
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Model.SourcePath, TargetNullValue=路径不可用}"
                                                                       FontSize="11"
                                                                       Margin="0,1,0,0"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Model.SourcePath}" />
                                                        </StackPanel>
                                                        
                                                        <!-- Actions stay quiet until the row is hovered or selected. -->
                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <StackPanel.Style>
                                                                <Style TargetType="{x:Type StackPanel}">
                                                                    <Setter Property="Opacity" Value="0" />
                                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                            <Setter Property="IsHitTestVisible" Value="True" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                            <Setter Property="IsHitTestVisible" Value="True" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <Button Width="30"
                                                                    Height="28"
                                                                    Padding="0"
                                                                    Margin="0,0,3,0"
                                                                    Foreground="{DynamicResource AccentBrush}"
                                                                    Style="{StaticResource GhostButtonStyle}"
                                                                    ToolTip="打开"
                                                                    Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <Path Data="M 7,2 L 15,2 L 15,10 M 15,2 L 7,10 M 12,7 L 12,15 L 2,15 L 2,5 L 10,5"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.35"
                                                                      Width="14"
                                                                      Height="14"
                                                                      Stretch="Uniform" />
                                                            </Button>
                                                            <Button Width="30"
                                                                    Height="28"
                                                                    Padding="0"
                                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                                    Style="{StaticResource GhostButtonStyle}"
                                                                    ToolTip="从收纳盒移除"
                                                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <Path Data="M 2,4 L 14,4 M 5,4 L 5,2 L 11,2 L 11,4 M 4,4 L 4.8,15 L 11.2,15 L 12,4 M 7,7 L 7,12 M 9,7 L 9,12"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.25"
                                                                      Width="14"
                                                                      Height="14"
                                                                      Stretch="Uniform" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                 </DockPanel>
                             </Border>

                            <Border Grid.Row="2"
                                    MinHeight="62"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <Grid Margin="14,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="36"
                                            Height="36"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="10"
                                            VerticalAlignment="Center">
                                        <Path Data="M 7,1 L 7,11 M 3,7 L 7,11 L 11,7 M 2,14 L 12,14"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Width="13"
                                              Height="15"
                                              Stretch="Uniform" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,12,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="拖入文件到当前收纳盒"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="普通盒会移动文件，映射盒只保存原路径"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource PanelAltBrush}"
                                            BorderThickness="0"
                                            CornerRadius="8"
                                            Padding="10,5">
                                        <TextBlock Text="拖放即可整理"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11"
                                                   FontWeight="Medium" />
                                    </Border>
                                </Grid>
                            </Border>
                         </Grid>

                        <views:TodoBoxDetailView Grid.Row="1"
                                                 DataContext="{Binding TodoBoxDetail}"
                                                 Visibility="{Binding DataContext.IsSelectedTodoBox,
                                                                      RelativeSource={RelativeSource AncestorType={x:Type Window}},
                                                                      Converter={StaticResource BooleanToVisibilityConverter}}" />
                     </Grid>

                    <!-- Todo Archive Page -->
                    <Grid Visibility="{Binding IsArchivePage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                 <TextBlock Text="待办历史"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            FontSize="11"
                                            FontWeight="SemiBold" />
                                <TextBlock Text="归档"
                                           Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                            FontSize="24"
                                            FontWeight="SemiBold" />
                                <TextBlock Text="从桌面待办盒归档的已完成事项会保存在这里"
                                            Margin="0,4,0,0"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            FontSize="12" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="11"
                                    Padding="13,7">
                                <TextBlock Text="{Binding ArchivedTodos.Count, StringFormat={}{0} 项}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding ArchivedTodos.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                                    <Border Width="48"
                                            Height="48"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="24">
                                        <Grid>
                                            <Path Data="M 14,17 L 34,17 M 17,17 L 18.5,34 L 29.5,34 L 31,17 M 20,13 L 28,13 L 30,17 L 18,17 Z"
                                                  Stroke="{DynamicResource AccentBrush}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"
                                                  Stretch="None" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="还没有归档事项"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="在桌面待办盒中完成事项后，点击“归档”"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12" />
                                </StackPanel>

                                <ListBox ItemsSource="{Binding ArchivedTodos}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,7" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                        <Border x:Name="ArchiveRow"
                                                                Background="{DynamicResource PanelAltBrush}"
                                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                                BorderThickness="1"
                                                                CornerRadius="11"
                                                                Padding="12,10">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ArchiveRow" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28"
                                                        Height="28"
                                                        Background="{DynamicResource PositiveSoftBrush}"
                                                        CornerRadius="14"
                                                        VerticalAlignment="Center">
                                                    <Path Data="M 7,14 L 11.5,18 L 21,9"
                                                          Stroke="{DynamicResource PositiveBrush}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Stretch="None" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding BoxName}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="  ·  "
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="10.5" />
                                                        <TextBlock Text="{Binding ArchivedTimeLabel}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="10.5" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="恢复"
                                                        Command="{Binding DataContext.RestoreArchivedTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Foreground="{DynamicResource AccentBrush}"
                                                        Margin="8,0,2,0"
                                                        Padding="10,4" />
                                                <Button Grid.Column="3"
                                                        Content="删除"
                                                        Command="{Binding DataContext.DeleteArchivedTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        Padding="10,4" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Settings Page -->
                    <Grid Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,7">
                            <TextBlock Text="设置"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       />
                            <TextBlock Text="系统设置"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}"
                                           BasedOn="{StaticResource DrawerScrollBarStyle}" />
                                </ScrollViewer.Resources>
                            <StackPanel Margin="0,0,4,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top">
                                <!-- Theme Settings Card -->
                                <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="外观皮肤"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding ThemeLabel, StringFormat=当前风格：{0}}"
                                                   Margin="0,2,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <UniformGrid Grid.Column="1" Columns="3" VerticalAlignment="Center">
                                        <UniformGrid.Resources>
                                            <Style x:Key="ThemeChoiceButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Height" Value="28" />
                                                <Setter Property="Padding" Value="9,2" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border x:Name="Root"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="9"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    RenderTransformOrigin="0.5,0.5">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                                                                </Border.RenderTransform>
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  RecognizesAccessKey="True" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                                                                    <Trigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="RootScale"
                                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                                 To="1.025"
                                                                                                 Duration="0:0:0.1" />
                                                                                <DoubleAnimation Storyboard.TargetName="RootScale"
                                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                                 To="1.025"
                                                                                                 Duration="0:0:0.1" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.EnterActions>
                                                                    <Trigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="RootScale"
                                                                                                 Storyboard.TargetProperty="ScaleX"
                                                                                                 To="1"
                                                                                                 Duration="0:0:0.12" />
                                                                                <DoubleAnimation Storyboard.TargetName="RootScale"
                                                                                                 Storyboard.TargetProperty="ScaleY"
                                                                                                 To="1"
                                                                                                 Duration="0:0:0.12" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.ExitActions>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="Root" Property="Opacity" Value="0.78" />
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style x:Key="MoeThemeChoiceButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ThemeChoiceButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMoeTheme}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                            <Style x:Key="GlassThemeChoiceButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ThemeChoiceButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGlassTheme}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                            <Style x:Key="CrystalThemeChoiceButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ThemeChoiceButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCrystalTheme}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTransparentCrystalBoxes}" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#FF0EA5E9" Offset="0" />
                                                                    <GradientStop Color="#FF0EA5E9" Offset="0.48" />
                                                                    <GradientStop Color="#730EA5E9" Offset="0.52" />
                                                                    <GradientStop Color="#260EA5E9" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="BorderBrush" Value="#990EA5E9" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </UniformGrid.Resources>
                                        <Button Content="清透雅致"
                                                Command="{Binding ApplyMoeThemeCommand}"
                                                Style="{StaticResource MoeThemeChoiceButtonStyle}"
                                                Margin="0,0,6,0" />
                                        <Button Content="暗黑曜石"
                                                Command="{Binding ApplyGlassThemeCommand}"
                                                Style="{StaticResource GlassThemeChoiceButtonStyle}"
                                                Margin="0,0,6,0" />
                                        <Button Content="全透水晶"
                                                Command="{Binding ApplyCrystalThemeCommand}"
                                                Style="{StaticResource CrystalThemeChoiceButtonStyle}" />
                                    </UniformGrid>
                                </Grid>
                                </Border>

                                <!-- Keyboard Shortcuts Card -->
                                <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="快速呼出面板"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="在全局按下快捷键以极速搜索与唤出 WitchDrawer"
                                                   Margin="0,2,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <Button x:Name="QuickPanelHotKeyButton"
                                                 MinWidth="128"
                                                 Height="28"
                                                Padding="12,2"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                Click="OnQuickPanelHotKeyButtonClick"
                                                PreviewKeyDown="OnQuickPanelHotKeyPreviewKeyDown"
                                                LostKeyboardFocus="OnQuickPanelHotKeyLostKeyboardFocus"
                                                ToolTip="点击后按下新的快捷键组合" />
                                        <TextBlock x:Name="QuickPanelHotKeyStatusText"
                                                   Margin="0,4,0,0"
                                                   MaxWidth="210"
                                                   TextAlignment="Right"
                                                   TextWrapping="Wrap"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                                </Border>

                                <!-- Update Check Card -->
                            <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="检查更新"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding CurrentVersionText}"
                                                   Margin="0,2,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding UpdateStatusText}"
                                                   Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding UpdateStatusText, Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="检查更新"
                                             Command="{Binding CheckForUpdateCommand}"
                                             Style="{StaticResource PrimaryButtonStyle}"
                                             Height="28"
                                            Padding="12,0"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Data Storage Card -->
                            <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="数据存储位置"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding CurrentDataDirectory}"
                                                   Margin="0,2,0,0"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="迁移会把数据库与盒内文件复制到新文件夹，重启后生效；原目录会保留作为备份。"
                                                   Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="更改位置…"
                                            Click="OnChangeDataDirectoryClick"
                                            Margin="12,0,0,0"
                                            Height="28"
                                            Padding="12,0"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Startup Card -->
                                <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="开机自启动"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="系统启动时自动运行 WitchDrawer"
                                                   Margin="0,2,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                             Command="{Binding ToggleLaunchOnStartupCommand}"
                                             VerticalAlignment="Center"
                                             Height="28"
                                            MinWidth="52"
                                            Padding="12,0">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="已关闭" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Border x:Name="Root"
                                                                    Background="{DynamicResource PanelAltBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="9"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LaunchOnStartup}" Value="True">
                                                        <Setter Property="Content" Value="已开启" />
                                                        <Setter Property="Foreground" Value="White" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type Button}">
                                                                    <Border x:Name="Root"
                                                                            Background="{DynamicResource AccentBrush}"
                                                                            BorderBrush="{DynamicResource AccentBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="9"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                </Border>

                                <!-- Custom Widget Rules Card -->
                                <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="桌面微件特性"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="WitchDrawer 桌面收纳栏专为极简桌面开发。仅呈现智能分类图标与轻量投放区，所有多余的标题栏、管理和刷新功能已统一收归本控制台进行操作，以保持您桌面清爽洁净。"
                                               Margin="0,2,0,0"
                                               FontSize="11.5"
                                               LineHeight="15"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                    </Grid>

                    <!-- About Page -->
                    <Grid Visibility="{Binding IsAboutPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,7">
                            <TextBlock Text="应用信息"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="关于"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="24"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Margin="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top">
                                <!-- App Info Card -->
                                <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="16"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Border CornerRadius="16" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#33FFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="0.6" />
                                                <GradientStop Color="#1A000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Margin="12" Orientation="Horizontal">
                                        <Border Width="44" Height="44" CornerRadius="12" ClipToBounds="True" Background="Transparent">
                                            <Image Source="/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" Width="44" Height="44" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="WitchDrawer"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="轻量级 Windows 桌面文件收纳工具"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       Opacity="0.85"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                </Border>

                                <!-- Author Card -->
                                <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="开发者"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,6" />

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="作者"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="Thewitchcat"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="邮箱"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="witchscottishfoldcat@gmail.com"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Cursor="Hand"
                                                   ToolTip="Open email"
                                                   MouseLeftButtonUp="OnOpenEmailClicked" />
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="网站"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="www.witchcat.cn"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Cursor="Hand"
                                                   ToolTip="Open website"
                                                   MouseLeftButtonUp="OnOpenWebsiteClicked" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="开源协议"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="6"
                                                Padding="8,2"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="CC BY-NC-SA 4.0"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="12"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                </Border>

                                <!-- Project Link Card -->
                                <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="项目仓库"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="github.com/witchscottishfoldcat/WitchDrawer"
                                                   Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="在浏览器中打开"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="OnOpenProjectLinkClicked"
                                            Height="30"
                                            Padding="12,0" />
                                </Grid>
                                </Border>
                            </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
