<Window x:Class="WitchDrawer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WitchDrawer.App.Localization"
        xmlns:views="clr-namespace:WitchDrawer.App.Views"
        xmlns:controls="clr-namespace:WitchDrawer.App.Controls"
        xmlns:viewModels="clr-namespace:WitchDrawer.App.ViewModels"
        xmlns:infrastructure="clr-namespace:WitchDrawer.App.Infrastructure"
        Title="WitchDrawer"
        Icon="/Assets/app.png"
        Width="1000"
        Height="620"
        MinWidth="920"
        MinHeight="560"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Drop="OnFilesDropped"
        PreviewMouseDown="OnMainWindowPreviewMouseDown"
        Deactivated="OnMainWindowDeactivated"
        PreviewDragOver="OnPreviewDragOver">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WitchDrawer.App;component/Views/Styles/MainWindow/SidebarStyles.xaml" />
                <ResourceDictionary Source="/WitchDrawer.App;component/Views/Styles/MainWindow/BoxControlsStyles.xaml" />
                <ResourceDictionary Source="/WitchDrawer.App;component/Views/Styles/MainWindow/SettingsCardStyles.xaml" />
                <ResourceDictionary Source="/WitchDrawer.App;component/Views/Styles/MainWindow/ThemeCardStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="14"
            Background="{DynamicResource ControlCenterSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Color="#000000" Opacity="0.12" ShadowDepth="3" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ControlCenterSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="24,24,0,0"
                    IsHitTestVisible="False" />

            <!-- Top Header & Custom Window Chrome -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnShellHeaderMouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Width="32" Height="32" CornerRadius="9" ClipToBounds="True" Background="Transparent">
                        <Image Source="/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" Width="32" Height="32" />
                    </Border>
                    <TextBlock Text="WitchDrawer"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               />
                </StackPanel>

                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,4"
                        IsHitTestVisible="False">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10.5"
                               FontWeight="Medium" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="{DynamicResource PanelAltBrush}"
                            BorderThickness="0"
                            CornerRadius="9"
                            Padding="10,5"
                            Margin="0,0,10,0">
                        <TextBlock Text="Ctrl+Alt+W"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   FontWeight="Medium" />
                    </Border>

                    <Button Width="34"
                            Height="34"
                            Padding="0"
                            Focusable="False"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="OnMinimizeClicked"
                            ToolTip="{loc:Text Minimize}">
                        <Path Data="M 1,5 L 11,5"
                              Stroke="{DynamicResource TextMutedBrush}"
                              StrokeThickness="1.4"
                              Width="12"
                              Height="10"
                              Stretch="Uniform" />
                    </Button>
                    <Button Width="34"
                            Height="34"
                            Padding="0"
                            Focusable="False"
                            Click="OnCloseClicked"
                            ToolTip="{loc:Text Close}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButtonStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Panel -->
            <Grid Grid.Row="1" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="222" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1"
                        Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="0,0,24,0"
                        IsHitTestVisible="False" />

                <!-- Left Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource PanelAltBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,24"
                        Padding="14,18,14,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Height="32"
                              Margin="10,0,10,7"
                              AutomationProperties.Name="{loc:Text BoxList}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock TextWrapping="Wrap" Text="{loc:Text Boxes}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Boxes.Count}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                            <ListBox x:Name="BoxesList"
                                     Grid.Row="1"
                                     ItemsSource="{Binding Boxes}"
                                     SelectedItem="{Binding SelectedBox, Mode=TwoWay}"
                                     AllowDrop="True"
                                     SelectionChanged="OnBoxesSelectionChanged"
                                     MouseDoubleClick="OnBoxesMouseDoubleClick"
                                     PreviewMouseLeftButtonDown="OnBoxesPreviewMouseLeftButtonDown"
                                     PreviewMouseLeftButtonUp="OnBoxesPreviewMouseLeftButtonUp"
                                     PreviewMouseMove="OnBoxesPreviewMouseMove"
                                     DragOver="OnBoxesDragOver"
                                     Drop="OnBoxesDrop"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     Margin="0,0,0,6">
                                <ListBox.Resources>
                                    <Style TargetType="{x:Type ScrollBar}"
                                           BasedOn="{StaticResource DrawerScrollBarStyle}" />
                                </ListBox.Resources>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="MinHeight" Value="52" />
                                        <Setter Property="Padding" Value="10,8" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <Border x:Name="Root"
                                                            Margin="0,2"
                                                            Padding="{TemplateBinding Padding}"
                                                            Background="Transparent"
                                                            BorderThickness="1"
                                                            BorderBrush="Transparent"
                                                            CornerRadius="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border x:Name="Indicator"
                                                                    Width="3"
                                                                    Height="18"
                                                                    Background="{DynamicResource AccentBrush}"
                                                                    CornerRadius="2"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="Collapsed"
                                                                    Margin="-3,0,8,0" />
                                                            <ContentPresenter Grid.Column="1" />
                                                            <Border x:Name="DropBefore"
                                                                    Grid.ColumnSpan="2"
                                                                    Height="2"
                                                                    Margin="0,-7,0,0"
                                                                    Background="{DynamicResource AccentBrush}"
                                                                    CornerRadius="1"
                                                                    VerticalAlignment="Top"
                                                                    Panel.ZIndex="2"
                                                                    Visibility="Collapsed" />
                                                            <Border x:Name="DropAfter"
                                                                    Grid.ColumnSpan="2"
                                                                    Height="2"
                                                                    Margin="0,0,0,-7"
                                                                    Background="{DynamicResource AccentBrush}"
                                                                    CornerRadius="1"
                                                                    VerticalAlignment="Bottom"
                                                                    Panel.ZIndex="2"
                                                                    Visibility="Collapsed" />
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                            <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                                                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                        <Trigger Property="Tag" Value="DropBefore">
                                                            <Setter TargetName="DropBefore" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                        <Trigger Property="Tag" Value="DropAfter">
                                                            <Setter TargetName="DropAfter" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding StorageLabel}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="BadgeBorder"
                                                    Width="32"
                                                    Height="32"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    BorderThickness="0">
                                                <Grid Width="18" Height="18">
                                                    <Viewbox x:Name="NormalBoxIcon"
                                                             Width="18"
                                                             Height="18"
                                                             Stretch="Uniform">
                                                        <Canvas Width="18" Height="18">
                                                            <Path Style="{StaticResource SidebarBoxIconPathStyle}"
                                                                  Data="M 3.75,7.15 L 14.25,7.15 L 13.9,13.95 C 13.85,14.85 13.1,15.55 12.2,15.55 L 5.8,15.55 C 4.9,15.55 4.15,14.85 4.1,13.95 Z M 3.3,3.15 L 14.7,3.15 C 15.3,3.15 15.8,3.65 15.8,4.25 L 15.8,5.75 C 15.8,6.35 15.3,6.85 14.7,6.85 L 3.3,6.85 C 2.7,6.85 2.2,6.35 2.2,5.75 L 2.2,4.25 C 2.2,3.65 2.7,3.15 3.3,3.15 Z M 7,10.35 L 11,10.35" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <Viewbox x:Name="MappingBoxIcon"
                                                             Width="18"
                                                             Height="18"
                                                             Stretch="Uniform"
                                                             Visibility="Collapsed">
                                                        <Canvas Width="18" Height="18">
                                                            <Path Style="{StaticResource SidebarBoxIconPathStyle}"
                                                                  Data="M 7.4,11.5 L 5.8,13.1 C 4.7,14.2 3,14.2 1.9,13.1 C 0.8,12 0.8,10.3 1.9,9.2 L 4.4,6.7 C 5.5,5.6 7.2,5.6 8.3,6.7 M 10.6,6.5 L 12.2,4.9 C 13.3,3.8 15,3.8 16.1,4.9 C 17.2,6 17.2,7.7 16.1,8.8 L 13.6,11.3 C 12.5,12.4 10.8,12.4 9.7,11.3 M 6.6,11.4 L 11.4,6.6" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <Viewbox x:Name="TodoBoxIcon"
                                                             Width="18"
                                                             Height="18"
                                                             Stretch="Uniform"
                                                             Visibility="Collapsed">
                                                        <Canvas Width="18" Height="18">
                                                            <Path Style="{StaticResource SidebarBoxIconPathStyle}"
                                                                  Data="M 5.15,2.35 L 12.85,2.35 C 14.4,2.35 15.65,3.6 15.65,5.15 L 15.65,12.85 C 15.65,14.4 14.4,15.65 12.85,15.65 L 5.15,15.65 C 3.6,15.65 2.35,14.4 2.35,12.85 L 2.35,5.15 C 2.35,3.6 3.6,2.35 5.15,2.35 Z M 5.45,9.15 L 8.05,11.75 L 12.85,6.55" />
                                                        </Canvas>
                                                    </Viewbox>
                                                    <Viewbox x:Name="DrawerBoxIcon"
                                                             Width="18"
                                                             Height="18"
                                                             Stretch="Uniform"
                                                             Visibility="Collapsed">
                                                        <Canvas Width="18" Height="18">
                                                            <Rectangle Canvas.Left="3.25"
                                                                       Canvas.Top="3.25"
                                                                       Style="{StaticResource SidebarBoxIconCellStyle}" />
                                                            <Rectangle Canvas.Left="10.5"
                                                                       Canvas.Top="3.25"
                                                                       Style="{StaticResource SidebarBoxIconCellStyle}" />
                                                            <Rectangle Canvas.Left="3.25"
                                                                       Canvas.Top="10.5"
                                                                       Style="{StaticResource SidebarBoxIconCellStyle}" />
                                                            <Rectangle Canvas.Left="10.5"
                                                                       Canvas.Top="10.5"
                                                                       Style="{StaticResource SidebarBoxIconCellStyle}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                            FontSize="13.5"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                            FontSize="11"
                                                           Margin="0,1,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Mapping">
                                                <Setter TargetName="NormalBoxIcon" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="MappingBoxIcon" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Todo">
                                                <Setter TargetName="NormalBoxIcon" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="TodoBoxIcon" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Drawer">
                                                <Setter TargetName="NormalBoxIcon" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="DrawerBoxIcon" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                            <Button x:Name="BtnCreateBox"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnCreateBoxClicked"
                                    AutomationProperties.Name="{loc:Text New}"
                                    MinHeight="40">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 0,4 L 8,4 M 4,0 L 4,8" Stroke="White" StrokeThickness="1.5" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" SnapsToDevicePixels="True" />
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Text New}" VerticalAlignment="Center" FontSize="12.5" />
                                </StackPanel>
                            </Button>

                            <!-- 定制级极简纯净菜单悬浮窗 -->
                            <Popup x:Name="CreateBoxPopup"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   PlacementTarget="{Binding ElementName=BtnCreateBox}"
                                   Placement="Top"
                                   VerticalOffset="-6"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="6"
                                        Margin="16">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.12" Direction="270" />
                                    </Border.Effect>
                                    <StackPanel MinWidth="224">
                                        <Button Content="{loc:Text NormalBox}"
                                                Click="OnCreateNormalBoxClicked"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Margin="0,0,0,4"
                                                Padding="12,10" />
                                        <Button Content="{loc:Text MappingBox}" Click="OnCreateMappingBoxClicked" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,4" Padding="12,10" />
                                        <Button Content="{loc:Text DrawerBox2}" Click="OnCreateDrawerBoxClicked" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,4" Padding="12,10" />
                                        <Button Content="{loc:Text TaskBox}" Click="OnCreateTodoBoxClicked" Style="{StaticResource GhostButtonStyle}" Padding="12,10" />
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Border Height="1"
                                    Margin="8,9,8,5"
                                     Background="{DynamicResource BorderBrushSoft}"
                                     Opacity="0.72" />

                            <UniformGrid Columns="3">
                                <Button Command="{Binding ShowArchiveCommand}"
                                        Style="{StaticResource NavArchiveButtonStyle}"
                                        AutomationProperties.Name="{loc:Text Archive}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <Path Data="M 2,5 L 17,5 L 17,17 L 2,17 Z M 1,2 L 18,2 L 18,6 L 1,6 Z M 7,9 L 12,9"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.4"
                                              Width="14"
                                              Height="14"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,0,2" />
                                        <TextBlock TextWrapping="Wrap" Text="{loc:Text Archive}"
                                                   FontSize="11.5"
                                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ShowSettingsCommand}"
                                        Style="{StaticResource NavSettingsButtonStyle}"
                                        AutomationProperties.Name="{loc:Text Settings}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <Path Data="M 9.5,2 L 11,2.5 L 11.8,5 L 14.2,5.8 L 16.5,4.7 L 17.5,6 L 16,8.2 L 16,10.8 L 17.5,13 L 16.5,14.3 L 14.2,13.2 L 11.8,14 L 11,16.5 L 9.5,17 L 8,16.5 L 7.2,14 L 4.8,13.2 L 2.5,14.3 L 1.5,13 L 3,10.8 L 3,8.2 L 1.5,6 L 2.5,4.7 L 4.8,5.8 L 7.2,5 L 8,2.5 Z M 7,9.5 A 2.5,2.5 0 1 0 12,9.5 A 2.5,2.5 0 1 0 7,9.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.25"
                                              Width="14"
                                              Height="14"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,0,2" />
                                        <TextBlock TextWrapping="Wrap" Text="{loc:Text Settings}"
                                                   FontSize="11.5"
                                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ShowAboutCommand}"
                                        Style="{StaticResource NavAboutButtonStyle}"
                                        AutomationProperties.Name="{loc:Text About}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE946;"
                                                   Width="15"
                                                   Margin="0,0,0,2"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="14"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBlock TextWrapping="Wrap" Text="{loc:Text About}"
                                                   FontSize="11.5"
                                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Content Area -->
                <Grid Grid.Column="1" Margin="24,18,24,22" VerticalAlignment="Stretch">
                    <!-- Dashboard Page -->
                    <Grid VerticalAlignment="Stretch">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAboutPage}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsArchivePage}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Selected box: three consistent entry points -->
                        <Grid x:Name="SelectedBoxToolbar" Grid.Row="0" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock TextWrapping="Wrap" Text="{loc:Text SelectABox, Value={Binding SelectedBox.Name}, Fallback=True}"
                                           TextTrimming="CharacterEllipsis" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock TextWrapping="Wrap" Text="{loc:Text SelectABoxOnTheLeftToStartOrganizing, Value={Binding SelectedBox.Description}, Fallback=True}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="BoxToolbarButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers><DataTrigger Binding="{Binding SelectedBox}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Margin="0,0,8,0" Visibility="{Binding SelectedBox.SupportsSorting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button x:Name="DrawerSortMenuButton" Style="{StaticResource BoxToolbarButtonStyle}" Click="OnOpenDrawerSortMenu"
                                            ToolTip="{loc:Text ChooseSortOrder}" AutomationProperties.Name="{loc:Text SortOrder}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock TextWrapping="Wrap" Text="{loc:Text Sort, Value={Binding SelectedBox.DrawerSortModeLabel}}" VerticalAlignment="Center" />
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="8" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Popup x:Name="DrawerSortPopup" PreviewKeyDown="OnBoxPopupKeyDown"
                                           PlacementTarget="{Binding ElementName=DrawerSortMenuButton}"
                                           Placement="Bottom"
                                           VerticalOffset="6"
                                           AllowsTransparency="True"
                                           StaysOpen="False"
                                           PopupAnimation="Fade">
                                        <Border Margin="12"
                                                Padding="5"
                                                MinWidth="156"
                                                Background="{DynamicResource PanelBrush}"
                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="14"
                                                                  ShadowDepth="3"
                                                                  Opacity="0.12"
                                                                  Direction="270" />
                                            </Border.Effect>
                                            <StackPanel>
                                                <Button Command="{Binding SelectedBox.ApplyDrawerSortModeCommand}"
                                                        CommandParameter="{x:Static viewModels:DrawerItemSortMode.Free}"
                                                        Click="OnDrawerSortOptionClicked"
                                                        Style="{StaticResource BoxMenuItemButtonStyle}"
                                                        Padding="10,0">
                                                    <Grid Width="128">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE73E;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding SelectedBox.IsFreeSort, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{loc:Text Free}" />
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding SelectedBox.ApplyDrawerSortModeCommand}"
                                                        CommandParameter="{x:Static viewModels:DrawerItemSortMode.Name}"
                                                        Click="OnDrawerSortOptionClicked"
                                                        Style="{StaticResource BoxMenuItemButtonStyle}"
                                                        Padding="10,0">
                                                    <Grid Width="128">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE73E;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding SelectedBox.IsDrawerSortByName, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{loc:Text Name}" />
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding SelectedBox.ApplyDrawerSortModeCommand}"
                                                        CommandParameter="{x:Static viewModels:DrawerItemSortMode.Size}"
                                                        Click="OnDrawerSortOptionClicked"
                                                        Style="{StaticResource BoxMenuItemButtonStyle}"
                                                        Padding="10,0">
                                                    <Grid Width="128">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE73E;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding SelectedBox.IsDrawerSortBySize, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{loc:Text Size}" />
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding SelectedBox.ApplyDrawerSortModeCommand}"
                                                        CommandParameter="{x:Static viewModels:DrawerItemSortMode.ItemType}"
                                                        Click="OnDrawerSortOptionClicked"
                                                        Style="{StaticResource BoxMenuItemButtonStyle}"
                                                        Padding="10,0">
                                                    <Grid Width="128">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE73E;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding SelectedBox.IsDrawerSortByItemType, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{loc:Text Type}" />
                                                    </Grid>
                                                </Button>
                                                <Button Command="{Binding SelectedBox.ApplyDrawerSortModeCommand}"
                                                        CommandParameter="{x:Static viewModels:DrawerItemSortMode.ModifiedDate}"
                                                        Click="OnDrawerSortOptionClicked"
                                                        Style="{StaticResource BoxMenuItemButtonStyle}"
                                                        Padding="10,0">
                                                    <Grid Width="128">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE73E;"
                                                                   FontFamily="Segoe Fluent Icons"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   Visibility="{Binding SelectedBox.IsDrawerSortByModifiedDate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock TextWrapping="Wrap" Grid.Column="1" Text="{loc:Text DateModified}" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid Margin="0,0,8,0" Visibility="{Binding IsSelectedTodoBox, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <Button x:Name="BoxDisplaySettingsButton" Style="{StaticResource BoxToolbarButtonStyle}" Click="OnOpenBoxDisplaySettings"
                                            AutomationProperties.Name="{loc:Text DisplaySettings}" ToolTip="{loc:Text IconsHoverTitlesAndBoxSize}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock TextWrapping="Wrap" Text="{loc:Text DisplaySettings}" VerticalAlignment="Center" />
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="8" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Popup x:Name="BoxDisplaySettingsPopup" PlacementTarget="{Binding ElementName=BoxDisplaySettingsButton}"
                                           Placement="Custom" AllowsTransparency="True" StaysOpen="True">
                                        <Border Width="360" Padding="16" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
                                                BorderThickness="1" CornerRadius="12" PreviewKeyDown="OnBoxPopupKeyDown">
                                            <views:BoxDisplaySettingsView x:Name="BoxDisplaySettings" />
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Grid>
                                    <Button x:Name="BtnMoreBoxActions" Style="{StaticResource BoxToolbarButtonStyle}" Click="OnOpenBoxActionsMenu"
                                            ToolTip="{loc:Text RenameDesktopPositionAndDelete}" AutomationProperties.Name="{loc:Text MoreBoxActions}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock TextWrapping="Wrap" Text="{loc:Text More}" VerticalAlignment="Center" />
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons" FontSize="8" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Popup x:Name="BoxActionsPopup" PreviewKeyDown="OnBoxPopupKeyDown"
                                               PlacementTarget="{Binding ElementName=BtnMoreBoxActions}"
                                               Placement="Bottom"
                                               VerticalOffset="6"
                                               AllowsTransparency="True"
                                               StaysOpen="True"
                                               PopupAnimation="Fade">
                                            <Border Margin="14"
                                                    Padding="6"
                                                    MinWidth="174"
                                                    Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16"
                                                                      ShadowDepth="4"
                                                                      Opacity="0.14"
                                                                      Direction="270" />
                                                </Border.Effect>
                                                <StackPanel>
                                                    <Button Content="{loc:Text Rename}" Click="OnRenameBoxClicked" Style="{StaticResource BoxMenuItemButtonStyle}"
                                                            AutomationProperties.Name="{loc:Text RenameThisBox}" />
                                                    <Button Click="OnShowDesktopBoxClicked"
                                                            Style="{StaticResource BoxMenuItemButtonStyle}"
                                                            AutomationProperties.Name="{loc:Text ShowDesktopBox}"
                                                            Padding="10,0"
                                                            HorizontalContentAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE890;"
                                                                       Width="20"
                                                                       FontFamily="Segoe Fluent Icons"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock TextWrapping="Wrap" Text="{loc:Text ShowDesktopBox}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Command="{Binding ToggleSelectedBoxPositionLockCommand}"
                                                            Click="OnBoxActionMenuItemClicked"
                                                            Style="{StaticResource BoxMenuItemButtonStyle}"
                                                            AutomationProperties.Name="{Binding SelectedBox.PositionLockButtonToolTip}"
                                                            Padding="10,0"
                                                            HorizontalContentAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE72E;"
                                                                       Width="20"
                                                                       FontFamily="Segoe Fluent Icons"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Text="{Binding SelectedBox.PositionLockButtonToolTip}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Click="OnRecallBoxClicked"
                                                            Style="{StaticResource BoxMenuItemButtonStyle}"
                                                            AutomationProperties.Name="{loc:Text MoveTheBoxToTheScreenCenter}"
                                                            Padding="10,0"
                                                            HorizontalContentAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE72C;"
                                                                       Width="20"
                                                                       FontFamily="Segoe Fluent Icons"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock TextWrapping="Wrap" Text="{loc:Text MoveToScreenCenter}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Border Height="1"
                                                            Margin="8,4"
                                                            Background="{DynamicResource BorderBrushSoft}" />
                                                    <Button Click="OnDeleteBoxClicked"
                                                            Style="{StaticResource BoxMenuItemButtonStyle}"
                                                            Foreground="{DynamicResource DangerBrush}"
                                                            AutomationProperties.Name="{loc:Text DeleteBox}"
                                                            Padding="10,0"
                                                            HorizontalContentAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE74D;"
                                                                       Width="20"
                                                                       FontFamily="Segoe Fluent Icons"
                                                                       FontSize="13" />
                                                            <TextBlock TextWrapping="Wrap" Text="{loc:Text DeleteBox}"
                                                                       FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                </Grid>
                            </StackPanel>
                            <Grid Width="0" Height="0">
                                <Popup x:Name="RenameBoxPopup"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PlacementTarget="{Binding ElementName=BtnMoreBoxActions}"
                                               Placement="Bottom"
                                               HorizontalOffset="-150"
                                               VerticalOffset="6"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12,12"
                                                    Margin="16">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.15" Direction="270" />
                                                </Border.Effect>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="TxtRenameBox"
                                                             Width="180" Height="32"
                                                             VerticalContentAlignment="Center"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             Background="{DynamicResource PanelBrush}"
                                                             BorderBrush="{DynamicResource BorderBrushSoft}"
                                                             BorderThickness="1"
                                                             Padding="8,0"
                                                             KeyDown="OnRenameBoxKeyDown"
                                                             PreviewKeyDown="OnRenameBoxPreviewKeyDown" />
                                                    <Button Content="{loc:Text Confirm}"
                                                            Click="OnConfirmRenameBoxClicked"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Margin="8,0,0,0"
                                                            Padding="16,0" Height="32"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                <Popup x:Name="DeleteConfirmPopup"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PlacementTarget="{Binding ElementName=BtnMoreBoxActions}"
                                               Placement="Bottom"
                                               VerticalOffset="6"
                                               HorizontalOffset="-92"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="16,14"
                                                    Margin="16">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="18"
                                                                      ShadowDepth="5"
                                                                      Opacity="0.16"
                                                                      Direction="270" />
                                                </Border.Effect>
                                                <StackPanel MinWidth="210">
                                                    <TextBlock TextWrapping="Wrap" Text="{loc:Text DeleteThisBox}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Margin="0,0,0,6" />
                                                    <TextBlock Text="{Binding SelectedBox.DeleteWarning}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,0,0,14"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <Button Content="{loc:Text Cancel}"
                                                                Click="OnCancelDeleteBoxClicked"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Margin="0,0,6,0"
                                                                Padding="12,5" />
                                                        <Button Content="{loc:Text Delete}"
                                                                Click="OnConfirmDeleteBoxClicked"
                                                                Style="{StaticResource DangerButtonStyle}"
                                                                Padding="14,5" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                <Popup x:Name="RecallBoxConfirmPopup"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PlacementTarget="{Binding ElementName=BtnMoreBoxActions}"
                                               Placement="Bottom"
                                               VerticalOffset="6"
                                               HorizontalOffset="-110"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="16,14"
                                                    Margin="16">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="18"
                                                                      ShadowDepth="5"
                                                                      Opacity="0.16"
                                                                      Direction="270" />
                                                </Border.Effect>
                                                <StackPanel MinWidth="230">
                                                    <TextBlock FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Margin="0,0,0,6">
                                                        <Run Text="{loc:Text Move}" />
                                                        <Run Text="{Binding SelectedBox.Name, Mode=OneWay}" />
                                                        <Run Text="{loc:Text ToTheScreenCenter}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{loc:Text TheBoxWillAppearAtTheCenterOfThe}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,0,0,14"
                                                               TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <Button Content="{loc:Text Cancel}"
                                                                Click="OnCancelRecallBoxClicked"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Margin="0,0,6,0"
                                                                Padding="12,5" />
                                                        <Button Content="{loc:Text Move2}"
                                                                Click="OnConfirmRecallBoxClicked"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Padding="14,5" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" VerticalAlignment="Stretch">
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelectedTodoBox}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Right Files List (Glass Card panel) -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="16,9"
                                    Margin="0,0,0,6">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="2,0,2,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="5"
                                                    Height="5"
                                                    CornerRadius="3"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Margin="1,0,8,0"
                                                    VerticalAlignment="Center" />
                                            <TextBlock TextWrapping="Wrap" Text="{loc:Text File}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold" />
                                            <TextBlock TextWrapping="Wrap" Text="{loc:Text DoubleClickToOpenDeleteToRemove}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right"
                                                Background="{DynamicResource PanelAltBrush}"
                                                CornerRadius="8"
                                                Padding="8,3">
                                            <TextBlock TextWrapping="Wrap" Text="{loc:Text Items4, Value={Binding Items.Count}}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </Border>
                                    </Grid>

                                    <Grid SizeChanged="OnMainItemsViewportSizeChanged">
                                        <!-- Empty State -->
                                        <Grid Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,16">
                                                <Path Data="M 5,12 L 20,4 L 35,12 L 35,28 L 20,36 L 5,28 Z M 5,12 L 20,20 L 35,12 M 20,20 L 20,36" 
                                                      Stroke="{DynamicResource BorderBrushSoft}" StrokeThickness="2" Width="48" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                                <TextBlock TextWrapping="Wrap" Text="{loc:Text ThisBoxIsEmpty}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="14.5"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock TextWrapping="Wrap" Text="{loc:Text DropFilesHereToOrganizeThemIntoThisBox}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11.5"
                                                           Margin="0,5,0,0"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Files ListBox -->
                                        <ListBox x:Name="MainItemsList"
                                                 ItemsSource="{Binding Items}"
                                                 VerticalAlignment="Top"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 ClipToBounds="True"
                                                 PreviewKeyDown="OnMainItemsPreviewKeyDown"
                                                 MouseDoubleClick="OnItemsMouseDoubleClick"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 Visibility="{Binding Items.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <ListBox.Template>
                                                <ControlTemplate TargetType="{x:Type ListBox}">
                                                    <ScrollViewer Focusable="False"
                                                                  Padding="{TemplateBinding Padding}"
                                                                  CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </ControlTemplate>
                                            </ListBox.Template>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Setter Property="MinHeight" Value="48" />
                                                    <Setter Property="Padding" Value="8,5" />
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                <!-- Card border -->
                                                                <Border x:Name="Root"
                                                                        Background="Transparent"
                                                                        BorderBrush="Transparent"
                                                                        BorderThickness="1"
                                                                        CornerRadius="9"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                        <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                        <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <Border Width="32"
                                                                Height="32"
                                                                CornerRadius="9"
                                                                Background="{DynamicResource GlassInnerBrush}"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0"
                                                                HorizontalAlignment="Left">
                                                            <Grid>
                                                                <Image Source="{Binding IconImage}"
                                                                       infrastructure:DeferredIconLoad.IsEnabled="True"
                                                                       Width="20"
                                                                       Height="20"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                       UseLayoutRounding="True"
                                                                       SnapsToDevicePixels="True"
                                                                       Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <TextBlock Text="{Binding FallbackIconText}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="9"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           Visibility="{Binding HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                            </Grid>
                                                        </Border>
                                                        
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock TextWrapping="Wrap" Text="{loc:Text PathUnavailable, Value={Binding Model.SourcePath}, Fallback=True}"
                                                                       FontSize="11"
                                                                       Margin="0,1,0,0"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Model.SourcePath}" />
                                                        </StackPanel>
                                                        
                                                        <!-- Actions stay quiet until the row is hovered or selected. -->
                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <StackPanel.Style>
                                                                <Style TargetType="{x:Type StackPanel}">
                                                                    <Setter Property="Opacity" Value="0" />
                                                                    <Setter Property="IsHitTestVisible" Value="False" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                            <Setter Property="IsHitTestVisible" Value="True" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                            <Setter Property="IsHitTestVisible" Value="True" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <Button Width="30"
                                                                    Height="28"
                                                                    Padding="0"
                                                                    Margin="0,0,3,0"
                                                                    Foreground="{DynamicResource AccentBrush}"
                                                                    Style="{StaticResource GhostButtonStyle}"
                                                                    ToolTip="{loc:Text Open}"
                                                                    Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <Path Data="M 7,2 L 15,2 L 15,10 M 15,2 L 7,10 M 12,7 L 12,15 L 2,15 L 2,5 L 10,5"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.35"
                                                                      Width="14"
                                                                      Height="14"
                                                                      Stretch="Uniform" />
                                                            </Button>
                                                            <Button Width="30"
                                                                    Height="28"
                                                                    Padding="0"
                                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                                    Style="{StaticResource GhostButtonStyle}"
                                                                    ToolTip="{loc:Text RemoveFromBox}"
                                                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <Path Data="M 2,4 L 14,4 M 5,4 L 5,2 L 11,2 L 11,4 M 4,4 L 4.8,15 L 11.2,15 L 12,4 M 7,7 L 7,12 M 9,7 L 9,12"
                                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                      StrokeThickness="1.25"
                                                                      Width="14"
                                                                      Height="14"
                                                                      Stretch="Uniform" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                 </DockPanel>
                             </Border>

