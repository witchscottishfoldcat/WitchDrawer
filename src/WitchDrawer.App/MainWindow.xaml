                                                            Tag="1"
                                                            Click="OnDeleteLayoutBackupClicked"
                                                            AutomationProperties.Name="{loc:Text DeleteLayoutInBackupSlot1}"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Visibility="Collapsed"
                                                            Height="26"
                                                            Padding="10,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Background="{DynamicResource PanelAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="8,5"
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock TextWrapping="Wrap" Text="{loc:Text BackupSlot2}"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock TextWrapping="Wrap" x:Name="LayoutBackupSlot2Status"
                                                               Text="{loc:Text Empty}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button x:Name="LayoutBackupSlot2RecordButton"
                                                            Content="{loc:Text Save}"
                                                            Tag="2"
                                                            Click="OnRecordLayoutBackupClicked"
                                                            AutomationProperties.Name="{loc:Text SaveLayoutToBackupSlot2}"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            Height="26"
                                                            Padding="11,0"
                                                            Margin="0,0,5,0" />
                                                    <Button x:Name="LayoutBackupSlot2RestoreButton"
                                                            Content="{loc:Text Restore}"
                                                            Tag="2"
                                                            Click="OnRestoreLayoutBackupClicked"
                                                            AutomationProperties.Name="{loc:Text RestoreLayoutFromBackupSlot2}"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Visibility="Collapsed"
                                                            Height="26"
                                                            Padding="11,0"
                                                            Margin="0,0,5,0" />
                                                    <Button x:Name="LayoutBackupSlot2DeleteButton"
                                                            Content="{loc:Text Delete}"
                                                            Tag="2"
                                                            Click="OnDeleteLayoutBackupClicked"
                                                            AutomationProperties.Name="{loc:Text DeleteLayoutInBackupSlot2}"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Visibility="Collapsed"
                                                            Height="26"
                                                            Padding="10,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Background="{DynamicResource PanelAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="8,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock TextWrapping="Wrap" Text="{loc:Text BackupSlot3}"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock TextWrapping="Wrap" x:Name="LayoutBackupSlot3Status"
                                                               Text="{loc:Text Empty}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button x:Name="LayoutBackupSlot3RecordButton"
                                                            Content="{loc:Text Save}"
                                                            Tag="3"
                                                            Click="OnRecordLayoutBackupClicked"
                                                            AutomationProperties.Name="{loc:Text SaveLayoutToBackupSlot3}"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            Height="26"
                                                            Padding="11,0"
                                                            Margin="0,0,5,0" />
                                                    <Button x:Name="LayoutBackupSlot3RestoreButton"
                                                            Content="{loc:Text Restore}"
                                                            Tag="3"
                                                            Click="OnRestoreLayoutBackupClicked"
                                                            AutomationProperties.Name="{loc:Text RestoreLayoutFromBackupSlot3}"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Visibility="Collapsed"
                                                            Height="26"
                                                            Padding="11,0"
                                                            Margin="0,0,5,0" />
                                                    <Button x:Name="LayoutBackupSlot3DeleteButton"
                                                            Content="{loc:Text Delete}"
                                                            Tag="3"
                                                            Click="OnDeleteLayoutBackupClicked"
                                                            AutomationProperties.Name="{loc:Text DeleteLayoutInBackupSlot3}"
                                                            Style="{StaticResource DangerButtonStyle}"
                                                            Visibility="Collapsed"
                                                            Height="26"
                                                            Padding="10,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Update Check Card -->
                            <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="{loc:Text CheckForUpdates}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Updates.CurrentVersionText}"
                                                   Margin="0,2,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Updates.UpdateStatusText}"
                                                   Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding Updates.UpdateStatusText, Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{loc:Text CheckForUpdates}"
                                             Command="{Binding Updates.CheckForUpdateCommand}"
                                             Style="{StaticResource PrimaryButtonStyle}"
                                             Height="28"
                                            Padding="12,0"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Data Storage Card -->
                            <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="{loc:Text DataStorage}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Maintenance.CurrentDataDirectory}"
                                                   Margin="0,2,0,0"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{loc:Text CopyTheDatabaseAndBoxFilesToANew}"
                                                   Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="{loc:Text ChangeLocation}"
                                            Click="OnChangeDataDirectoryClick"
                                            Margin="12,0,0,0"
                                            Height="28"
                                            Padding="12,0"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Startup Card -->
                                <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="{loc:Text LaunchAtStartup}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" Text="{loc:Text RunWitchDrawerWhenWindowsStarts}"
                                                   Margin="0,2,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource SettingsToggleButtonStyle}"
                                                  IsChecked="{Binding Settings.LaunchOnStartup, Mode=OneWay}"
                                                  Command="{Binding Settings.ToggleLaunchOnStartupCommand}"
                                                  AutomationProperties.Name="{loc:Text LaunchAtStartup}" />
                                </Grid>
                                </Border>

                                <!-- Windows Desktop Icons Card -->
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Text="{loc:Text HideDesktopIcons}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{loc:Text HideWindowsDesktopFilesFoldersShortcutsAndSystemIcons}"
                                                       Margin="0,2,12,0"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource SettingsToggleButtonStyle}"
                                                      IsChecked="{Binding Settings.AreDesktopIconsHidden, Mode=OneWay}"
                                                      Command="{Binding Settings.ToggleDesktopIconsCommand}"
                                                      AutomationProperties.Name="{loc:Text HideDesktopIcons}" />
                                    </Grid>
                                </Border>

                                <!-- Desktop Double-click Card -->
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Text="{loc:Text DoubleClickDesktopToToggleIcons}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{loc:Text DoubleClickAnEmptyDesktopAreaToHideOr}"
                                                       Margin="0,2,12,0"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource SettingsToggleButtonStyle}"
                                                      IsChecked="{Binding Settings.IsDesktopDoubleClickEnabled, Mode=OneWay}"
                                                      Command="{Binding Settings.ToggleDesktopDoubleClickCommand}"
                                                      AutomationProperties.Name="{loc:Text DoubleClickDesktopToToggleIcons}" />
                                    </Grid>
                                </Border>

                                <!-- Custom Widget Rules Card -->
                                <Border Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Text DesktopWidgets}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Text WitchDrawerKeepsYourDesktopSimpleWithFileIconsAnd}"
                                               Margin="0,2,0,0"
                                               FontSize="11.5"
                                               LineHeight="15"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                    </Grid>

                    <!-- About Page -->
                    <controls:LazyPageHost PageType="{x:Type views:AboutPageView}"
                                           Visibility="{Binding IsAboutPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
