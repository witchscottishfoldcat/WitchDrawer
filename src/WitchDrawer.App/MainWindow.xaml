                                                     MaxLength="3"
                                                     TextAlignment="Right"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="11.5"
                                                     FontWeight="SemiBold"
                                                     KeyDown="OnThemeTransparencyInputKeyDown"
