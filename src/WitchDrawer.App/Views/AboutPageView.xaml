<UserControl x:Class="WitchDrawer.App.Views.AboutPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WitchDrawer.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,7">
            <TextBlock Text="{loc:Text AppInformation}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11"
                       FontWeight="SemiBold" />
            <TextBlock Text="{loc:Text About}"
                       Margin="0,2,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="24"
                       FontWeight="SemiBold" />
        </StackPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="VerticalOnly"
                          CanContentScroll="False">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}"
                           BasedOn="{StaticResource DrawerScrollBarStyle}" />
                </ScrollViewer.Resources>
                <StackPanel HorizontalAlignment="Stretch"
                            VerticalAlignment="Top">
                <!-- App Info Card -->
                <Border Background="{DynamicResource AccentBrush}"
                    CornerRadius="16"
                    Margin="0,0,0,8">
                <Grid>
                    <Border CornerRadius="16" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#33FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="0.6" />
                                <GradientStop Color="#1A000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="12" Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" ClipToBounds="True" Background="Transparent">
                            <Image Source="/Assets/app.png" RenderOptions.BitmapScalingMode="HighQuality" Width="44" Height="44" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="WitchDrawer"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold" />
                            <TextBlock Text="{loc:Text ALightweightWindowsDesktopFileOrganizer}"
                                       Foreground="White"
                                       FontSize="12"
                                       Opacity="0.85"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                </Border>

                <!-- Usage Guide Card -->
                <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text GettingStarted}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="{loc:Text DropAFileOrFolderIntoABoxTo}"
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,5" />
                    <TextBlock Text="{loc:Text NormalBoxesMoveFilesAndFoldersIntoWitchDrawerS}"
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,5" />
                    <TextBlock Text="{loc:Text MappingBoxesStoreOriginalPathsAndLeaveSourceFiles}"
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,7" />
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="8"
                            Padding="8,6"
                            Margin="0,0,0,7">
                        <TextBlock Text="{loc:Text TipUseMappingBoxesForFoldersToAvoidMoving}"
                                   TextWrapping="Wrap"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{loc:Text CompatibilitySomeFeaturesMayNotWorkOnWindows10}"
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                </Border>

                <!-- Diagnostic Export Card -->
                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{loc:Text DiagnosticsAndFeedback}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Text IfSomethingGoesWrongExportRecentLogsToShare}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{loc:Text ExcludesTheDatabaseAndUserFilesLogsMayInclude}"
                                       Margin="0,4,0,0"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <Button x:Name="ExportDiagnosticLogsButton"
                                Grid.Column="1"
                                Content="{loc:Text ExportDiagnosticLogs}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnExportDiagnosticLogsClick"
                                AutomationProperties.Name="{loc:Text ExportWitchDrawerDiagnosticLogs}"
                                Height="30"
                                Padding="12,0"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Author Support Card -->
                <Border x:Name="AuthorSupportCard"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="{loc:Text SponsorTheAuthor}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:Text SupportOngoingDevelopmentAndMaintenanceOfWitchDrawer}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{loc:Text IncludeYourIDWhenSponsoringToBeAddedTo}"
                                       Margin="0,5,0,0"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{loc:Text VisitSponsorshipPage}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnOpenSupportLinkClicked"
                                AutomationProperties.Name="{loc:Text OpenTheAuthorSSponsorshipPageInYourBrowser}"
                                Height="30"
                                Padding="12,0"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Author Card -->
                <Border x:Name="DeveloperCard"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Text Developer}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Author}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12.5"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="Thewitchcat"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Email}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12.5"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="witchscottishfoldcat@gmail.com"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="12.5"
                                   VerticalAlignment="Center"
                                   Cursor="Hand"
                                   ToolTip="Open email"
                                   MouseLeftButtonUp="OnOpenEmailClicked" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Website}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12.5"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="www.witchcat.cn"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="12.5"
                                   VerticalAlignment="Center"
                                   Cursor="Hand"
                                   ToolTip="Open website"
                                   MouseLeftButtonUp="OnOpenWebsiteClicked" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text License}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12.5"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="6"
                                    Padding="8,2">
                                <TextBlock Text="PolyForm Noncommercial 1.0.0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="12"
                                           FontWeight="Bold" />
                            </Border>
                            <Border Margin="6,0,0,0"
                                    Background="{DynamicResource PanelAltBrush}"
                                    CornerRadius="6"
                                    Padding="8,2"
                                    ToolTip="{loc:Text DocumentationInDocsAndIconsAndArtworkInAssets}">
                                <TextBlock Text="{loc:Text DocsAndAssetsCCBYNCSA40}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11.5" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                </Border>

                <!-- Project Link Card -->
                <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Text ProjectRepository}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="github.com/witchscottishfoldcat/WitchDrawer"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{loc:Text OpenInBrowser}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OnOpenProjectLinkClicked"
                            Height="30"
                            Padding="12,0" />
                </Grid>
                </Border>
                </StackPanel>
            </ScrollViewer>
    </Grid>
</UserControl>
