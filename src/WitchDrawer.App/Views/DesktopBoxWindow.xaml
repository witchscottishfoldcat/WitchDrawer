<Window x:Class="WitchDrawer.App.Views.DesktopBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WitchDrawer.App.Controls"
        xmlns:infrastructure="clr-namespace:WitchDrawer.App.Infrastructure"
        Title="{Binding Name}"
        Icon="/Assets/app.png"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        ShowActivated="False"
        AllowDrop="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewDrop="OnFilesDropped"
        Drop="OnFilesDropped"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDragLeave="OnPreviewDragLeave">
    <Window.Style>
        <Style TargetType="{x:Type Window}">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="MinHeight" Value="120" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMappingListMode}" Value="True">
                    <Setter Property="MinWidth" Value="150" />
                    <Setter Property="MinHeight" Value="86" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDrawerCollapsed}" Value="True">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFixedSize}" Value="True">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <!-- 虚线滚动跑马灯动画 -->
        <Storyboard x:Key="ScrollDashes" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="DashRect"
                             Storyboard.TargetProperty="StrokeDashOffset"
                             From="0" To="7" Duration="0:0:0.6" />
        </Storyboard>

        <Style x:Key="MappingModeButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Opacity" Value="0.50" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TodoCompletionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Ellipse x:Name="CompletionRing"
                                     Fill="{DynamicResource GlassInnerBrush}"
                                     Stroke="{DynamicResource BorderBrushSoft}"
                                     StrokeThickness="1.4" />
                            <Path x:Name="CompletionCheck"
                                  Data="M 4.5,9.5 L 7.6,12.4 L 14.4,5.8"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="CompletionRing" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CompletionRing" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CompletionCheck" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CompletionRing" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TodoArchiveButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ArchiveRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArchiveRoot" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DrawerTileButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin"
                    Value="{Binding DataContext.LayoutSettings.DrawerHoverMargin, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="DrawerButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding DataContext.LayoutSettings.ItemCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="DrawerButtonScale" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DrawerButtonRoot" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DrawerButtonRoot" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="6" />
                <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GlassStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.16" ShadowDepth="2" Direction="270" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPixelStyle}" Value="True">
                        <Setter Property="CornerRadius" Value="14" />
                        <Setter Property="TextElement.FontFamily" Value="Consolas, Courier New, 微软雅黑" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMappingListMode}" Value="True">
                        <Setter Property="Margin" Value="{Binding LayoutSettings.MappingListWindowMargin}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDrawerCollapsed}" Value="True">
                        <Setter Property="CornerRadius" Value="24" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <Grid Background="Transparent" MouseLeftButtonDown="OnSurfaceMouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding HeaderRowHeight}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部标题栏与 macOS 关闭小红点 -->
            <!-- 三列布局：左侧名称 / 右侧视图切换 / 关闭按钮。 -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  Visibility="{Binding IsHeaderVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           Visibility="{Binding IsTitleVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="14,0,8,0"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMappingListMode}" Value="True">
                                    <Setter Property="FontSize" Value="{Binding LayoutSettings.MappingListTitleFontSize}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 映射盒视图切换按钮（网格/列表），独占一列避免与 X 重叠 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <StackPanel.Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMappingBox}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Click="OnUseMappingGridModeClick"
                            ToolTip="网格视图"
                            Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MappingModeButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridMode}" Value="True">
                                        <Setter Property="Opacity" Value="0.85" />
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M 2,2 L 7,2 L 7,7 L 2,7 Z M 10,2 L 15,2 L 15,7 L 10,7 Z M 2,10 L 7,10 L 7,15 L 2,15 Z M 10,10 L 15,10 L 15,15 L 10,15 Z"
                              Stroke="{DynamicResource TextMutedBrush}"
                              StrokeThickness="1.4"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </Button>
                    <Button Click="OnUseMappingListModeClick"
                            ToolTip="列表视图">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MappingModeButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMappingListMode}" Value="True">
                                        <Setter Property="Opacity" Value="0.85" />
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M 3,4 L 15,4 M 3,8 L 15,8 M 3,12 L 15,12"
                              Stroke="{DynamicResource TextMutedBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <Button Grid.Column="1"
                        Width="24"
                        Height="18"
                        MinWidth="0"
                        MinHeight="0"
                        Margin="0,0,8,0"
                        Padding="0"
                        Click="OnCollapseDrawerClick"
                        ToolTip="收起抽屉"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MappingModeButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDrawerExpanded}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="M 2,6 L 7,11 L 12,6"
                          Stroke="{DynamicResource TextMutedBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="12"
                          Height="9"
                          Stretch="Uniform" />
                </Button>

                <!-- 关闭小按钮 (悬浮变亮红，自带微过渡，像素模式下自动方块化) -->
                <Button Grid.Column="2"
                        Click="OnCloseClick"
                        Width="12"
                        Height="12"
                        Focusable="False">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <!-- The global Button style has MinHeight=34. Reset it here so
                                 this control is genuinely 12x12 instead of a 12px glyph
                                 centered inside a hidden 34px layout box. -->
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMappingListMode}" Value="True">
                                    <Setter Property="Margin" Value="0,0,10,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsMappingListMode}" Value="True" />
                                        <Condition Binding="{Binding LayoutSettings.IsCompactPreset}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Margin" Value="0,0,8,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Rectangle x:Name="Circle" Fill="#20808080" Width="12" Height="12" RadiusX="6" RadiusY="6" SnapsToDevicePixels="True" />
                                <Path x:Name="Cross"
                                      Data="M 0,0 L 6,6 M 6,0 L 0,6"
                                      Width="6"
                                      Height="6"
                                      Stretch="None"
                                      Stroke="White"
                                      StrokeThickness="1.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Opacity="0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Path.RenderTransform>
                                        <TranslateTransform X="0.5" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Circle" Property="Fill" Value="#FF5F56" />
                                    <Setter TargetName="Cross" Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 主内容区: ListBox -->
            <ListBox x:Name="IconList"
                     Grid.Row="1"
                     Panel.ZIndex="1"
                     Margin="6,0,6,6"
                     Padding="2"
                     Width="{Binding GridViewportWidth}"
                     Height="{Binding GridViewportHeight}"
                     MaxWidth="{Binding LayoutSettings.GridViewportMaxWidth}"
                     MaxHeight="{Binding LayoutSettings.GridViewportMaxHeight}"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     BorderThickness="0"
                     Background="Transparent"
                     Focusable="True"
                     FocusVisualStyle="{x:Null}"
                     ItemsSource="{Binding Items}"
                     SelectionMode="Single"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="{Binding GridHorizontalScrollBarVisibility}"
                     ScrollViewer.VerticalScrollBarVisibility="{Binding GridVerticalScrollBarVisibility}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionChanged="OnItemsSelectionChanged"
                     PreviewMouseLeftButtonDown="OnIconPreviewMouseLeftButtonDown"
                     MouseMove="OnIconMouseMove"
                     MouseDoubleClick="OnItemsMouseDoubleClick">
                <ListBox.Style>
                    <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMappingListMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTodoBox}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDrawerCollapsed}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingCanvas
                            ItemWidth="{Binding DataContext.LayoutSettings.ItemSlotWidth, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                            ItemHeight="{Binding DataContext.LayoutSettings.ItemSlotHeight, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                            ContentWidth="{Binding DataContext.GridCanvasWidth, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                            ContentHeight="{Binding DataContext.GridCanvasHeight, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Canvas.Left" Value="{Binding GridLeft}" />
                        <Setter Property="Canvas.Top" Value="{Binding GridTop}" />
                        <Setter Property="Width" Value="{Binding DataContext.LayoutSettings.ItemSlotWidth, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                        <Setter Property="Height" Value="{Binding DataContext.LayoutSettings.ItemSlotHeight, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                        <Setter Property="Padding" Value="{Binding DataContext.LayoutSettings.ItemPadding, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border x:Name="Root"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1.2"
                                            Margin="{Binding DataContext.LayoutSettings.ItemMargin, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            Padding="{TemplateBinding Padding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="{Binding DataContext.LayoutSettings.ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsPixelStyle, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True">
                                                        <Setter Property="CornerRadius" Value="6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ContentPresenter x:Name="ItemContent" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Normal hover -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding DataContext.Type, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="Normal" />
                                                <Condition Binding="{Binding DataContext.IsPixelStyle, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </MultiDataTrigger>

                                        <!-- Mapping hover -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding DataContext.Type, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="Mapping" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </MultiDataTrigger>

                                        <!-- Pixel hover (instant background change, no animation) -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                <Condition Binding="{Binding DataContext.IsPixelStyle, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </MultiDataTrigger>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="Transparent" />
                                            <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                                            <Setter TargetName="ItemContent" Property="Opacity" Value="0.38" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding PathLabel}">
                            <!-- 图标卡片背景 -->
                            <Border x:Name="IconBorder"
                                    Width="{Binding DataContext.LayoutSettings.IconFrameSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                    Height="{Binding DataContext.LayoutSettings.IconFrameSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                    CornerRadius="{Binding DataContext.LayoutSettings.IconCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                    Background="{DynamicResource GlassInnerBrush}"
                                    BorderBrush="{DynamicResource GlassStrokeBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <Grid>
                                    <Image x:Name="IconImage"
                                           infrastructure:DeferredIconLoad.IsEnabled="True"
                                           Width="{Binding DataContext.LayoutSettings.IconSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                           Height="{Binding DataContext.LayoutSettings.IconSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Source="{Binding IconImage}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           UseLayoutRounding="True"
                                           SnapsToDevicePixels="True"
                                           Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    
                                    <TextBlock Text="{Binding FallbackIconText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="{Binding DataContext.LayoutSettings.FallbackIconFontSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Visibility="{Binding HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsPixelStyle, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True">
                                <Setter TargetName="IconBorder" Property="CornerRadius" Value="4" />
                                <Setter TargetName="IconImage" Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox x:Name="FileList"
                     Grid.Row="1"
                     Panel.ZIndex="1"
                      Width="{Binding LayoutSettings.MappingListWidth}"
                      MinHeight="{Binding LayoutSettings.MappingListMinHeight}"
                      MaxHeight="{Binding LayoutSettings.MappingListMaxHeight}"
                      Margin="{Binding LayoutSettings.MappingListMargin}"
                      Padding="{Binding LayoutSettings.MappingListPadding}"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     BorderThickness="0"
                     Background="Transparent"
                     Focusable="True"
                     FocusVisualStyle="{x:Null}"
                     ItemsSource="{Binding Items}"
                     SelectionMode="Single"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionChanged="OnItemsSelectionChanged"
                     PreviewMouseLeftButtonDown="OnIconPreviewMouseLeftButtonDown"
                     MouseMove="OnIconMouseMove"
                     MouseDoubleClick="OnItemsMouseDoubleClick">
                <ListBox.Style>
                    <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMappingListMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Height" Value="{Binding DataContext.LayoutSettings.MappingListRowHeight, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                        <Setter Property="Padding" Value="{Binding DataContext.LayoutSettings.MappingListItemPadding, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                        <Setter Property="Margin" Value="{Binding DataContext.LayoutSettings.MappingListItemMargin, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border x:Name="Root"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding PathLabel}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding DataContext.LayoutSettings.MappingListIconColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="{Binding DataContext.LayoutSettings.MappingListIconFrameSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                  Height="{Binding DataContext.LayoutSettings.MappingListIconFrameSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Image Source="{Binding IconImage}"
                                       infrastructure:DeferredIconLoad.IsEnabled="True"
                                       Width="{Binding DataContext.LayoutSettings.MappingListIconSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                       Height="{Binding DataContext.LayoutSettings.MappingListIconSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       UseLayoutRounding="True"
                                       SnapsToDevicePixels="True"
                                       Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Border Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="2"
                                        Padding="2,1"
                                        Visibility="{Binding HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding FallbackIconText}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="{Binding DataContext.LayoutSettings.MappingListFallbackFontSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="{Binding DataContext.LayoutSettings.MappingListFontSize, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 待办收纳盒：与文件盒共用原生桌面浮窗外壳，但拥有独立的持久化内容。 -->
            <Grid Grid.Row="1"
                  Panel.ZIndex="3"
                  Width="310"
                  MinHeight="190"
                  MaxHeight="430"
                  Margin="8,4,8,10"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTodoBox}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TODAY"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10.5"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="归档"
                            Command="{Binding ArchiveCompletedTodosCommand}"
                            Style="{StaticResource TodoArchiveButtonStyle}"
                            Margin="0,0,6,0"
                            Foreground="{DynamicResource TextMutedBrush}"
                            FontSize="10.5"
                            ToolTip="将所有已完成待办移入主页归档" />
                    <Border Grid.Column="2"
                            Background="{DynamicResource AccentSoftBrush}"
                            CornerRadius="8"
                            Padding="8,3">
                        <TextBlock Text="{Binding TodoRemainingCount, StringFormat=剩余 {0}}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource GlassInnerBrush}"
                        BorderBrush="{DynamicResource GlassStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="5"
                        Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TodoTitleTextBox"
                                 Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnTodoTitleKeyDown"
                                 PreviewMouseLeftButtonDown="OnTodoTitlePreviewMouseLeftButtonDown"
                                 MaxLength="200"
                                 Height="32"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="12.5"
                                 ToolTip="输入待办内容，按 Enter 添加" />
                        <TextBlock Margin="9,0,0,0"
                                   Text="添加待办..."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewTodoTitle}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1"
                                Content="+"
                                Command="{Binding AddTodoCommand}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Style="{StaticResource MappingModeButtonStyle}"
                                ToolTip="添加待办" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding TodoItems.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                        <TextBlock Text="✓"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="暂无待办"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding TodoItems}"
                             Visibility="{Binding TodoItems.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="Root"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="7,6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Command="{Binding DataContext.ToggleTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TodoCompletionButtonStyle}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            ToolTip="切换完成状态" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Opacity" Value="0.48" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TimeLabel}"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="9.5" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="×"
                                            Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            Margin="6,0,0,0"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="15"
                                            ToolTip="删除待办" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <Popup x:Name="DrawerSecondaryPopup"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   Opened="OnDrawerSecondaryPopupOpened">
                <Border x:Name="DrawerSecondaryPopupRoot"
                        Width="{Binding DrawerSecondaryPanelWidth}"
                        Height="{Binding DrawerSecondaryPanelHeight}"
                        PreviewMouseMove="OnDrawerIconMouseMove"
                        Opacity="0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource GlassStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="DrawerSecondaryPopupScale"
                                        ScaleX="1"
                                        ScaleY="1" />
                    </Border.RenderTransform>
                    <Grid>
                        <Border Background="{DynamicResource DrawerSecondarySurfaceBrush}"
                                CornerRadius="23" />
                        <Border Margin="1"
                                BorderBrush="#4DFFFFFF"
                                BorderThickness="1"
                                CornerRadius="22"
                                IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#22FFFFFF" Offset="0" />
                                    <GradientStop Color="#04FFFFFF" Offset="0.52" />
                                    <GradientStop Color="#100EA5E9" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ListBox Margin="10"
                                 ItemsSource="{Binding DrawerSecondaryItems}"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Focusable="False"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DrawerSecondaryHasScrollableOverflow}"
                                                     Value="True">
                                            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:CenteredUniformPanel
                                            Columns="{Binding DataContext.DrawerSecondaryColumns, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CellSize="{Binding DataContext.LayoutSettings.ItemSlotWidth, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Margin" Value="2" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource DrawerTileButtonStyle}"
                                                Margin="0"
                                                ToolTip="{Binding PathLabel}"
                                                Click="OnDrawerSecondaryItemClick"
                                                PreviewMouseLeftButtonDown="OnDrawerSecondaryIconPreviewMouseLeftButtonDown">
                                            <Border Width="{Binding DataContext.LayoutSettings.DrawerPrimaryIconFrameSize, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    Height="{Binding DataContext.LayoutSettings.DrawerPrimaryIconFrameSize, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CornerRadius="{Binding DataContext.LayoutSettings.IconCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    Background="{DynamicResource GlassInnerBrush}"
                                                    BorderBrush="{DynamicResource GlassStrokeBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Image Width="{Binding DataContext.LayoutSettings.DrawerPrimaryIconSize, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                           infrastructure:DeferredIconLoad.IsEnabled="True"
                                                           Height="{Binding DataContext.LayoutSettings.DrawerPrimaryIconSize, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                           Source="{Binding IconImage}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding FallbackIconText}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="{Binding DataContext.LayoutSettings.FallbackIconFontSize, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                    </Grid>
                </Border>
            </Popup>

            <Grid Grid.Row="1"
                  Panel.ZIndex="5"
                  Background="Transparent"
                  Width="{Binding DrawerCoverWidth}"
                  Height="{Binding DrawerContentHeight}"
                  PreviewMouseMove="OnDrawerIconMouseMove"
                  PreviewMouseLeftButtonDown="OnDrawerSurfacePreviewMouseLeftButtonDown"
                  Visibility="{Binding IsDrawerCollapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Thumb Cursor="SizeAll"
                       DragStarted="OnDrawerMoveStarted"
                       DragDelta="OnDrawerMoveDelta"
                       DragCompleted="OnDrawerMoveCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Grid>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Margin"
                                    Value="{Binding LayoutSettings.DrawerSurfacePadding}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTitleVisible}" Value="True">
                                    <Setter Property="Margin" Value="10,3,10,10" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ItemsControl x:Name="DrawerCoverItems"
                                  ItemsSource="{Binding DrawerCoverTiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding DataContext.DrawerCoverColumns, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Rows="{Binding DataContext.DrawerCoverRows, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button Style="{StaticResource DrawerTileButtonStyle}"
                                            Click="OnDrawerDirectItemClick"
                                            PreviewMouseLeftButtonDown="OnDrawerIconPreviewMouseLeftButtonDown"
                                            ToolTip="{Binding Item.PathLabel}"
                                            Visibility="{Binding HasItem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Width="{Binding DataContext.LayoutSettings.DrawerPrimaryIconFrameSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.LayoutSettings.DrawerPrimaryIconFrameSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CornerRadius="{Binding DataContext.LayoutSettings.IconCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="{DynamicResource GlassInnerBrush}"
                                                BorderBrush="{DynamicResource GlassStrokeBrush}"
                                                BorderThickness="1">
                                            <Grid DataContext="{Binding Item}">
                                                <Image Width="{Binding DataContext.LayoutSettings.DrawerPrimaryIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       infrastructure:DeferredIconLoad.IsEnabled="True"
                                                       Height="{Binding DataContext.LayoutSettings.DrawerPrimaryIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Source="{Binding IconImage}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding FallbackIconText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="{Binding DataContext.LayoutSettings.FallbackIconFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="{Binding HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <Button Style="{StaticResource DrawerTileButtonStyle}"
                                            Click="OnExpandDrawerClick"
                                            ToolTip="展开抽屉"
                                            Visibility="{Binding IsExpandTile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Padding="{Binding DataContext.LayoutSettings.DrawerPreviewGap, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Width="{Binding DataContext.LayoutSettings.DrawerPrimaryIconFrameSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Height="{Binding DataContext.LayoutSettings.DrawerPrimaryIconFrameSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CornerRadius="{Binding DataContext.LayoutSettings.IconCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="{DynamicResource GlassInnerBrush}"
                                                BorderBrush="{DynamicResource GlassStrokeBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <ItemsControl ItemsSource="{Binding DataContext.DrawerPreviewItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" Rows="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="{x:Type ContentPresenter}">
                                                            <Setter Property="Margin" Value="{Binding DataContext.LayoutSettings.DrawerPreviewGap, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="{Binding DataContext.LayoutSettings.DrawerPreviewIconFrameSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Height="{Binding DataContext.LayoutSettings.DrawerPreviewIconFrameSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CornerRadius="4"
                                                                    Background="{DynamicResource GlassSurfaceBrush}">
                                                                <Grid>
                                                                    <Image Width="{Binding DataContext.LayoutSettings.DrawerPreviewIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           infrastructure:DeferredIconLoad.IsEnabled="True"
                                                                           Height="{Binding DataContext.LayoutSettings.DrawerPreviewIconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           Source="{Binding IconImage}"
                                                                           Stretch="Uniform"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                                           Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <TextBlock Text="{Binding FallbackIconText}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               FontSize="7"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                               Visibility="{Binding HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="拖入文件至此"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   LineHeight="14"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="点击展开"
                                   Margin="0,2,0,0"
                                   FontSize="9.5"
                                   LineHeight="12"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>

                    <Thumb
                           Width="20"
                           Height="20"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,-8,-8"
                           Cursor="SizeNWSE"
                           Opacity="0.42"
                           DragStarted="OnDrawerResizeStarted"
                           DragDelta="OnDrawerResizeDelta"
                           DragCompleted="OnDrawerResizeCompleted">
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Grid Background="Transparent">
                                    <Path Data="M 5,15 L 15,5 M 10,15 L 15,10"
                                          Stroke="{DynamicResource TextMutedBrush}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Grid>

            <Canvas x:Name="DragPreviewCanvas"
                    Grid.Row="1"
                    Panel.ZIndex="2"
                    Margin="8,2,8,8"
                    IsHitTestVisible="False"
                    ClipToBounds="False"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Visibility="{Binding IsDragPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Width" Value="{Binding GridCanvasWidth}" />
                        <Setter Property="Height" Value="{Binding GridCanvasHeight}" />
                        <Style.Triggers>
                            <!-- Collapsed drawer: the frame is positioned over a cover cell;
                                 the canvas itself must not grow the SizeToContent window. -->
                            <DataTrigger Binding="{Binding IsDrawerCollapsed}" Value="True">
                                <Setter Property="Width" Value="0" />
                                <Setter Property="Height" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>
                <Rectangle Canvas.Left="{Binding DragPreviewLeft}"
                           Canvas.Top="{Binding DragPreviewTop}"
                           Width="{Binding DragPreviewWidth}"
                           Height="{Binding DragPreviewHeight}"
                           Fill="{DynamicResource AccentSoftBrush}"
                           Stroke="{DynamicResource AccentBrush}"
                           StrokeThickness="1.4"
                           StrokeDashArray="4 3"
                           Opacity="0.68"
                           RenderTransformOrigin="0.5,0.5">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="RadiusX" Value="{Binding LayoutSettings.ItemCornerRadius.TopLeft}" />
                            <Setter Property="RadiusY" Value="{Binding LayoutSettings.ItemCornerRadius.TopLeft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPixelStyle}" Value="True">
                                    <Setter Property="RadiusX" Value="6" />
                                    <Setter Property="RadiusY" Value="6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
            </Canvas>

            <!-- 空列表时: 拖拽投放槽 (跑马灯虚线动画) -->
            <Border Grid.Row="1"
                    Panel.ZIndex="0"
                    Background="Transparent"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False"
                    Visibility="{Binding ShowFileEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Margin" Value="14" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}"/>
                        <Style.Triggers>
                            <!-- 拖拽滑入时，卡片背景高亮，启动跑马灯 -->
                            <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFixedSize}" Value="True">
                                <Setter Property="Margin" Value="4" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- 流动虚线框 -->
                    <Rectangle x:Name="DashRect" 
                               Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"
                               StrokeThickness="1.5"
                               StrokeDashArray="4 3">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="RadiusX" Value="16" />
                                <Setter Property="RadiusY" Value="16" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPixelStyle}" Value="True">
                                        <Setter Property="RadiusX" Value="6" />
                                        <Setter Property="RadiusY" Value="6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                        <!-- 下载/拖入 Path 箭头 -->
                        <Path x:Name="ArrowPath"
                              Data="M 6,1 L 6,11 M 2,7 L 6,11 L 10,7 M 1,14 L 11,14" 
                              Stroke="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}" 
                              StrokeThickness="1.8" 
                              Width="12" Height="14" 
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,8" 
                              SnapsToDevicePixels="True">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="StrokeStartLineCap" Value="Round" />
                                    <Setter Property="StrokeEndLineCap" Value="Round" />
                                </Style>
                            </Path.Style>
                        </Path>
                        
                        <TextBlock x:Name="TitleText"
                                   Text="拖入文件至此"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        
                        <TextBlock Text="{Binding Description}"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
