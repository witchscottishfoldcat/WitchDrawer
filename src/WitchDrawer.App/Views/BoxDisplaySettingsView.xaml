<UserControl x:Class="WitchDrawer.App.Views.BoxDisplaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WitchDrawer.App.Views"
             MinWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WitchDrawer.App;component/Views/Styles/MainWindow/BoxControlsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel x:Name="BoxControlsPageHost">
        <TextBlock Text="显示设置" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />
        <Grid Margin="0,0,0,10" Visibility="{Binding SelectedBox.CanSelectVisualStyle, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="图标风格" Style="{StaticResource BoxControlLabelStyle}" />
            <ComboBox x:Name="VisualStyleChoice" Grid.Column="1" Style="{StaticResource BoxSettingChoiceStyle}"
                      ItemsSource="{Binding BoxVisualStyleOptions}" DisplayMemberPath="Name" SelectedValuePath="Style"
                      SelectedValue="{Binding SelectedBox.VisualStyle, Mode=OneWay}"
                      SelectionChanged="OnChoiceChanged" AutomationProperties.Name="图标风格" />
        </Grid>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="图标大小" Style="{StaticResource BoxControlLabelStyle}" />
            <ComboBox x:Name="IconSizeChoice" Grid.Column="1" Style="{StaticResource BoxSettingChoiceStyle}"
                      ItemsSource="{x:Static views:BoxDisplaySettingsView.IconSizeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedBox.LayoutSettings.CurrentPreset, Mode=OneWay}"
                      SelectionChanged="OnChoiceChanged" AutomationProperties.Name="图标大小" />
        </Grid>
        <Grid Margin="0,0,0,10" Visibility="{Binding SelectedBox.SupportsHoverRollUp, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="悬停展开" Style="{StaticResource BoxControlLabelStyle}" />
            <ComboBox x:Name="HoverChoice" Grid.Column="1" Style="{StaticResource BoxSettingChoiceStyle}"
                      ItemsSource="{x:Static views:BoxDisplaySettingsView.EnabledChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedBox.IsHoverRollUpEnabled, Mode=OneWay}"
                      SelectionChanged="OnChoiceChanged" AutomationProperties.Name="悬停展开" />
        </Grid>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="盒子标题" Style="{StaticResource BoxControlLabelStyle}" />
            <ComboBox x:Name="TitleChoice" Grid.Column="1" Style="{StaticResource BoxSettingChoiceStyle}"
                      ItemsSource="{x:Static views:BoxDisplaySettingsView.VisibilityChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedBox.IsTitleVisible, Mode=OneWay}"
                      SelectionChanged="OnChoiceChanged" AutomationProperties.Name="盒子标题" />
        </Grid>
        <Grid Margin="0,0,0,10" Visibility="{Binding SelectedBox.SupportsFileNameVisibility, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="文件名称" Style="{StaticResource BoxControlLabelStyle}" />
            <ComboBox x:Name="FileNameChoice" Grid.Column="1" Style="{StaticResource BoxSettingChoiceStyle}"
                      ItemsSource="{x:Static views:BoxDisplaySettingsView.VisibilityChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedBox.IsFileNameVisible, Mode=OneWay}"
                      SelectionChanged="OnChoiceChanged" AutomationProperties.Name="文件名称" />
        </Grid>
        <StackPanel Visibility="{Binding SelectedBox.SupportsFixedSize, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,3,0,14" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="盒子尺寸" Style="{StaticResource BoxControlLabelStyle}" />
                <ComboBox x:Name="SizeModeChoice" Grid.Column="1" Style="{StaticResource BoxSettingChoiceStyle}"
                          ItemsSource="{x:Static views:BoxDisplaySettingsView.SizeModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding BoxSizeSettings.IsFixedMode, Mode=OneWay}"
                          SelectionChanged="OnChoiceChanged" AutomationProperties.Name="盒子尺寸" />
            </Grid>
            <StackPanel x:Name="FixedSizeControls" Margin="92,10,0,0"
                        Visibility="{Binding BoxSizeSettings.IsFixedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="列" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button Content="−" Style="{StaticResource BoxSettingStepperStyle}" Command="{Binding BoxSizeSettings.DecreaseColumnsCommand}" ToolTip="减少列数" AutomationProperties.Name="减少列数" />
                            <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource BoxSettingStepperStyle}" Command="{Binding BoxSizeSettings.IncreaseColumnsCommand}" ToolTip="增加列数" AutomationProperties.Name="增加列数" />
                            <TextBlock Text="{Binding BoxSizeSettings.FixedColumns}" Style="{StaticResource BoxSettingNumberStyle}" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="行" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button Content="−" Style="{StaticResource BoxSettingStepperStyle}" Command="{Binding BoxSizeSettings.DecreaseRowsCommand}" ToolTip="减少行数" AutomationProperties.Name="减少行数" />
                            <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource BoxSettingStepperStyle}" Command="{Binding BoxSizeSettings.IncreaseRowsCommand}" ToolTip="增加行数" AutomationProperties.Name="增加行数" />
                            <TextBlock Text="{Binding BoxSizeSettings.FixedRows}" Style="{StaticResource BoxSettingNumberStyle}" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding BoxSizeSettings.ExtentHint}" TextWrapping="Wrap" FontSize="10.5"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
            </StackPanel>
        </StackPanel>
        <TextBlock Text="更改会立即应用到桌面收纳盒" FontSize="10.5"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
