<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Desktop-box selection visuals are intentionally isolated here.
        Keep SelectionOutline/DrawerSelectionOutline independent from content layout:
        theme, opacity, context-menu, and desktop-host changes must not merge these
        outlines back into their content roots or remove the -0.30 DIP compensation.
    -->
    <Style x:Key="DrawerTileButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin"
                Value="{Binding DataContext.LayoutSettings.DrawerHoverMargin, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="DrawerButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding DataContext.LayoutSettings.ItemCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="DrawerButtonScale" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="DrawerSelectionOutline"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1.2"
                                CornerRadius="{Binding CornerRadius, ElementName=DrawerButtonRoot}"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="False">
                            <Border.RenderTransform>
                                <TranslateTransform X="-0.30" Y="-0.30" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DrawerButtonRoot" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="DrawerButtonRoot" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="DrawerButtonRoot" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="DrawerSelectionOutline" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DesktopIconListItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Canvas.Left" Value="{Binding GridLeft}" />
        <Setter Property="Canvas.Top" Value="{Binding GridTop}" />
        <Setter Property="Width" Value="{Binding DataContext.LayoutSettings.ItemSlotWidth, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
        <Setter Property="Height" Value="{Binding DataContext.LayoutSettings.ItemSlotHeight, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
        <Setter Property="Padding" Value="{Binding DataContext.LayoutSettings.ItemPadding, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid Margin="{Binding DataContext.LayoutSettings.ItemMargin, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1.2"
                                Padding="{TemplateBinding Padding}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="{Binding DataContext.LayoutSettings.ItemCornerRadius, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsPixelStyle, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter x:Name="ItemContent" />
                        </Border>
                        <Border x:Name="SelectionOutline"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1.2"
                                CornerRadius="{Binding CornerRadius, ElementName=Root}"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="False">
                            <Border.RenderTransform>
                                <TranslateTransform X="-0.30" Y="-0.30" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.Type, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="Normal" />
                                <Condition Binding="{Binding DataContext.IsPixelStyle, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.Type, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="Mapping" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.IsPixelStyle, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </MultiDataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="SelectionOutline" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="Transparent" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="SelectionOutline" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="ItemContent" Property="Opacity" Value="0.38" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
