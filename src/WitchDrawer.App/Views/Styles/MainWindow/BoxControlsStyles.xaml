<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Selected-box controls card styles (labels, visual-style picker, icon-size
         choices, drawer sort choices, box size mode), lifted verbatim from
         MainWindow's local resource scopes. -->
    <Style x:Key="BoxControlLabelStyle"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="VisualStylePickerButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="MinWidth" Value="78" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="IconSizeChoiceButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style x:Key="ExtraLargeIconSizeButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IconSizeChoiceButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedBox.LayoutSettings.IsExtraLargePreset}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LargeIconSizeButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IconSizeChoiceButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedBox.LayoutSettings.IsLargePreset}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MediumIconSizeButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IconSizeChoiceButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedBox.LayoutSettings.IsMediumPreset}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SmallIconSizeButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource IconSizeChoiceButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedBox.LayoutSettings.IsSmallPreset}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DrawerSortChoiceButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style x:Key="DrawerSortByNameButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource DrawerSortChoiceButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedBox.IsDrawerSortByName}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DrawerSortBySizeButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource DrawerSortChoiceButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedBox.IsDrawerSortBySize}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DrawerSortByTypeButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource DrawerSortChoiceButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedBox.IsDrawerSortByItemType}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DrawerSortByDateButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource DrawerSortChoiceButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedBox.IsDrawerSortByModifiedDate}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SizeModeChoiceButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style x:Key="AdaptiveSizeModeButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource SizeModeChoiceButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding BoxSizeSettings.IsAdaptiveMode}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FixedSizeModeButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource SizeModeChoiceButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding BoxSizeSettings.IsFixedMode}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SizeStepperButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
